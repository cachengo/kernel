  mcu_r5fss0_core0: r5f@79000000 {
   compatible = "ti,am62-r5f";
   reg = <0x79000000 0x00008000>,
         <0x79020000 0x00008000>;
   reg-names = "atcm", "btcm";
   ti,sci = <&dmsc>;
   ti,sci-dev-id = <9>;
   ti,sci-proc-ids = <0x03 0xff>;
   resets = <&k3_reset 9 1>;
   firmware-name = "am62p-mcu-r5f0_0-fw";
   ti,atcm-enable = <0>;
   ti,btcm-enable = <1>;
   ti,loczrama = <0>;
  };
 };
};
