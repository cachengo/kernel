 mcasp0: audio-controller@2b00000 {
  compatible = "ti,am33xx-mcasp-audio";
  reg = <0x00 0x02b00000 0x00 0x2000>,
        <0x00 0x02b08000 0x00 0x400>;
  reg-names = "mpu", "dat";
  interrupts = <0 236 4>,
        <0 235 4>;
  interrupt-names = "tx", "rx";

  dmas = <&main_bcdma 0 0xc500 0>, <&main_bcdma 0 0x4500 0>;
