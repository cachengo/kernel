# 0 "arch/arm64/boot/dts/ti/k3-am642-phyboard-electra-gpio-fan.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/ti/k3-am642-phyboard-electra-gpio-fan.dtso"






/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 11 "arch/arm64/boot/dts/ti/k3-am642-phyboard-electra-gpio-fan.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/thermal/thermal.h" 1
# 12 "arch/arm64/boot/dts/ti/k3-am642-phyboard-electra-gpio-fan.dtso" 2
# 1 "arch/arm64/boot/dts/ti/k3-pinctrl.h" 1
# 13 "arch/arm64/boot/dts/ti/k3-am642-phyboard-electra-gpio-fan.dtso" 2

&{/} {
 fan: gpio-fan {
  compatible = "gpio-fan";
  gpio-fan,speed-map = <0 0 8600 1>;
  gpios = <&main_gpio0 28 1>;
  #cooling-cells = <2>;
  pinctrl-names = "default";
  pinctrl-0 = <&gpio_fan_pins_default>;
 };
};

&main_pmx0 {
 gpio_fan_pins_default: gpio-fan-default-pins {
  pinctrl-single,pins = <
   (((0x070) & 0x1fff)) ((((0 << (18)) | (1 << (16)))) | (7))
  >;
 };
};

&thermal_zones {
 main0_thermal: main0-thermal {
  trips {
   main0_thermal_trip0: main0-thermal-trip {
    temperature = <65000>;
    hysteresis = <2000>;
    type = "active";
   };
  };

  cooling-maps {
   map0 {
    trip = <&main0_thermal_trip0>;
    cooling-device = <&fan (~0) (~0)>;
   };
  };
 };
};
