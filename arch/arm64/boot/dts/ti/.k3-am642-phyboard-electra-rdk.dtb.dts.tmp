   firmware-name = "am64x-txpru0_1-fw";
  };

  icssg0_mdio: mdio@32400 {
   compatible = "ti,davinci_mdio";
   reg = <0x32400 0x100>;
   clocks = <&k3_clks 62 3>;
   clock-names = "fck";
   #address-cells = <1>;
