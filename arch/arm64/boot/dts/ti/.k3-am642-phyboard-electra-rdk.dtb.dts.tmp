 main_uart4: serial@2840000 {
  compatible = "ti,am64-uart", "ti,am654-uart";
  reg = <0x00 0x02840000 0x00 0x100>;
  interrupts = <0 182 4>;
  clock-frequency = <48000000>;
  power-domains = <&k3_pds 155 1>;
  clocks = <&k3_clks 155 0>;
  clock-names = "fclk";
