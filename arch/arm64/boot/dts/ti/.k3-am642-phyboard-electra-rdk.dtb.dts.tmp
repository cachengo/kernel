/dts-v1/;

# 1 "arch/arm64/boot/dts/ti/k3-am64.dtsi" 1
# 9 "arch/arm64/boot/dts/ti/k3-am64.dtsi"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/irq.h" 1
# 10 "arch/arm64/boot/dts/ti/k3-am64.dtsi" 2
