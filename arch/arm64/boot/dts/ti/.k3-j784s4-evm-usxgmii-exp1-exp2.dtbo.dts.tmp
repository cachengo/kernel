# 0 "arch/arm64/boot/dts/ti/k3-j784s4-evm-usxgmii-exp1-exp2.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/ti/k3-j784s4-evm-usxgmii-exp1-exp2.dtso"
# 9 "arch/arm64/boot/dts/ti/k3-j784s4-evm-usxgmii-exp1-exp2.dtso"
/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 13 "arch/arm64/boot/dts/ti/k3-j784s4-evm-usxgmii-exp1-exp2.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/phy/phy-cadence.h" 1
# 14 "arch/arm64/boot/dts/ti/k3-j784s4-evm-usxgmii-exp1-exp2.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/phy/phy.h" 1
# 15 "arch/arm64/boot/dts/ti/k3-j784s4-evm-usxgmii-exp1-exp2.dtso" 2

# 1 "arch/arm64/boot/dts/ti/k3-serdes.h" 1
# 17 "arch/arm64/boot/dts/ti/k3-j784s4-evm-usxgmii-exp1-exp2.dtso" 2

&{/} {
 aliases {
  ethernet1 = "/bus@100000/ethernet@c000000/ethernet-ports/port@1";
  ethernet2 = "/bus@100000/ethernet@c000000/ethernet-ports/port@2";
  ethernet3 = "/bus@100000/ethernet@c200000/ethernet-ports/port@1";
 };
};

&main_cpsw0 {
 pinctrl-names = "default";
 status = "okay";
};

&main_cpsw0_port1 {
 phy-mode = "usxgmii";
 mac-address = [00 00 00 00 00 00];
 phys = <&cpsw0_phy_gmii_sel 1>, <&serdes2_usxgmii_link>;
 phy-names = "mac", "serdes";
 status = "okay";
 fixed-link {
  speed = <5000>;
  full-duplex;
 };
};

&main_cpsw0_port2 {
 phy-mode = "usxgmii";
 mac-address = [00 00 00 00 00 00];
 phys = <&cpsw0_phy_gmii_sel 2>, <&serdes2_usxgmii_link>;
 phy-names = "mac", "serdes";
 status = "okay";
 fixed-link {
  speed = <5000>;
  full-duplex;
 };
};

&serdes_wiz2 {
 assigned-clock-parents = <&k3_clks 406 9>;
 status = "okay";
};

&serdes2 {
 #address-cells = <1>;
 #size-cells = <0>;
 status = "okay";

 serdes2_usxgmii_link: phy@2 {
  reg = <2>;
  cdns,num-lanes = <2>;
  #phy-cells = <0>;
  cdns,phy-type = <12>;
  resets = <&serdes_wiz2 3>, <&serdes_wiz2 4>;
 };
};

&serdes_ln_ctrl {
 idle-states = <0x1>, <0x1>,
        <0x2>, <0x2>,
        <0x1>, <0x1>,
        <0x1>, <0x1>,
        <0x1>, <0x1>,
        <0x1>, <0x1>;
};
