  };
 };
};

main4_thermal: main4-thermal {
 polling-delay-passive = <250>;
 polling-delay = <500>;
 thermal-sensors = <&wkup_vtm0 6>;

 trips {
  main4_crit: main4-crit {
   temperature = <125000>;
   hysteresis = <2000>;
   type = "critical";
  };
 };
};
# 143 "arch/arm64/boot/dts/ti/k3-j784s4-j742s2-common.dtsi" 2
 };
};


# 1 "arch/arm64/boot/dts/ti/k3-j784s4-j742s2-main-common.dtsi" 1







# 1 "./scripts/dtc/include-prefixes/dt-bindings/mux/mux.h" 1
# 9 "arch/arm64/boot/dts/ti/k3-j784s4-j742s2-main-common.dtsi" 2
