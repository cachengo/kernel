/ {
 interrupt-parent = <&gic500>;
 #address-cells = <2>;
 #size-cells = <2>;

 L2_0: l2-cache0 {
  compatible = "cache";
  cache-level = <2>;
  cache-unified;
  cache-size = <0x200000>;
  cache-line-size = <64>;
  cache-sets = <1024>;
  next-level-cache = <&msmc_l3>;
 };

 L2_1: l2-cache1 {
  compatible = "cache";
  cache-level = <2>;
  cache-unified;
  cache-size = <0x200000>;
  cache-line-size = <64>;
  cache-sets = <1024>;
  next-level-cache = <&msmc_l3>;
 };

 msmc_l3: l3-cache0 {
  compatible = "cache";
  cache-level = <3>;
  cache-unified;
 };

 firmware {
  optee {
   compatible = "linaro,optee-tz";
   method = "smc";
  };

  psci: psci {
   compatible = "arm,psci-1.0";
   method = "smc";
  };
 };

 a72_timer0: timer-cl0-cpu0 {
  compatible = "arm,armv8-timer";
  interrupts = <1 13 8>,
        <1 14 8>,
        <1 11 8>,
        <1 10 8>;
 };

 pmu: pmu {
  compatible = "arm,cortex-a72-pmu";

  interrupts = <1 7 4>;
 };

 cbass_main: bus@100000 {
  bootph-all;
  compatible = "simple-bus";
  #address-cells = <2>;
  #size-cells = <2>;
  ranges = <0x00 0x00100000 0x00 0x00100000 0x00 0x00020000>,
    <0x00 0x00600000 0x00 0x00600000 0x00 0x00031100>,
    <0x00 0x00700000 0x00 0x00700000 0x00 0x00001000>,
    <0x00 0x01000000 0x00 0x01000000 0x00 0x0d000000>,
    <0x00 0x04210000 0x00 0x04210000 0x00 0x00010000>,
    <0x00 0x04220000 0x00 0x04220000 0x00 0x00010000>,
    <0x00 0x0d000000 0x00 0x0d000000 0x00 0x00800000>,
    <0x00 0x0d800000 0x00 0x0d800000 0x00 0x00800000>,
    <0x00 0x0e000000 0x00 0x0e000000 0x00 0x00800000>,
    <0x00 0x0e800000 0x00 0x0e800000 0x00 0x00800000>,
    <0x00 0x10000000 0x00 0x10000000 0x00 0x08000000>,
    <0x00 0x18000000 0x00 0x18000000 0x00 0x08000000>,
    <0x00 0x64800000 0x00 0x64800000 0x00 0x0070c000>,
    <0x00 0x65800000 0x00 0x65800000 0x00 0x0070c000>,
    <0x00 0x66800000 0x00 0x66800000 0x00 0x0070c000>,
    <0x00 0x67800000 0x00 0x67800000 0x00 0x0070c000>,
    <0x00 0x6f000000 0x00 0x6f000000 0x00 0x00310000>,
    <0x00 0x70000000 0x00 0x70000000 0x00 0x00400000>,
    <0x00 0x30000000 0x00 0x30000000 0x00 0x0c400000>,
    <0x40 0x00000000 0x40 0x00000000 0x01 0x00000000>,
    <0x41 0x00000000 0x41 0x00000000 0x01 0x00000000>,
    <0x42 0x00000000 0x42 0x00000000 0x01 0x00000000>,
    <0x43 0x00000000 0x43 0x00000000 0x01 0x00000000>,
    <0x44 0x00000000 0x44 0x00000000 0x00 0x08000000>,
    <0x44 0x10000000 0x44 0x10000000 0x00 0x08000000>,
    <0x4e 0x20000000 0x4e 0x20000000 0x00 0x00080000>,


    <0x00 0x28380000 0x00 0x28380000 0x00 0x03880000>,
    <0x00 0x40200000 0x00 0x40200000 0x00 0x00998400>,
    <0x00 0x40f00000 0x00 0x40f00000 0x00 0x00020000>,
    <0x00 0x41000000 0x00 0x41000000 0x00 0x00020000>,
    <0x00 0x41400000 0x00 0x41400000 0x00 0x00020000>,
    <0x00 0x41c00000 0x00 0x41c00000 0x00 0x00100000>,
    <0x00 0x42040000 0x00 0x42040000 0x00 0x03ac2400>,
    <0x00 0x45100000 0x00 0x45100000 0x00 0x00c24000>,
    <0x00 0x46000000 0x00 0x46000000 0x00 0x00200000>,
    <0x00 0x47000000 0x00 0x47000000 0x00 0x00068400>,
    <0x00 0x50000000 0x00 0x50000000 0x00 0x10000000>,
    <0x04 0x00000000 0x04 0x00000000 0x04 0x00000000>;

  cbass_mcu_wakeup: bus@28380000 {
   bootph-all;
   compatible = "simple-bus";
   #address-cells = <2>;
   #size-cells = <2>;
   ranges = <0x00 0x28380000 0x00 0x28380000 0x00 0x03880000>,
     <0x00 0x40200000 0x00 0x40200000 0x00 0x00998400>,
     <0x00 0x40f00000 0x00 0x40f00000 0x00 0x00020000>,
     <0x00 0x41000000 0x00 0x41000000 0x00 0x00020000>,
     <0x00 0x41400000 0x00 0x41400000 0x00 0x00020000>,
     <0x00 0x41c00000 0x00 0x41c00000 0x00 0x00100000>,
     <0x00 0x42040000 0x00 0x42040000 0x00 0x03ac2400>,
     <0x00 0x45100000 0x00 0x45100000 0x00 0x00c24000>,
     <0x00 0x46000000 0x00 0x46000000 0x00 0x00200000>,
     <0x00 0x47000000 0x00 0x47000000 0x00 0x00068400>,
     <0x00 0x50000000 0x00 0x50000000 0x00 0x10000000>,
     <0x04 0x00000000 0x04 0x00000000 0x04 0x00000000>;
  };
 };

 thermal_zones: thermal-zones {
# 1 "arch/arm64/boot/dts/ti/k3-j784s4-j742s2-thermal-common.dtsi" 1





# 1 "./scripts/dtc/include-prefixes/dt-bindings/thermal/thermal.h" 1
# 7 "arch/arm64/boot/dts/ti/k3-j784s4-j742s2-thermal-common.dtsi" 2

wkup0_thermal: wkup0-thermal {
 polling-delay-passive = <250>;
 polling-delay = <500>;
 thermal-sensors = <&wkup_vtm0 0>;

 trips {
  wkup0_crit: wkup0-crit {
   temperature = <125000>;
   hysteresis = <2000>;
   type = "critical";
  };
 };
};

wkup1_thermal: wkup1-thermal {
 polling-delay-passive = <250>;
 polling-delay = <500>;
 thermal-sensors = <&wkup_vtm0 1>;

 trips {
  wkup1_crit: wkup1-crit {
   temperature = <125000>;
   hysteresis = <2000>;
   type = "critical";
  };
 };
};

main0_thermal: main0-thermal {
 polling-delay-passive = <250>;
 polling-delay = <500>;
 thermal-sensors = <&wkup_vtm0 2>;

 trips {
  main0_crit: main0-crit {
   temperature = <125000>;
   hysteresis = <2000>;
   type = "critical";
  };
 };
};

main1_thermal: main1-thermal {
 polling-delay-passive = <250>;
 polling-delay = <500>;
 thermal-sensors = <&wkup_vtm0 3>;

 trips {
  main1_crit: main1-crit {
   temperature = <125000>;
   hysteresis = <2000>;
   type = "critical";
  };
 };
};

main2_thermal: main2-thermal {
 polling-delay-passive = <250>;
 polling-delay = <500>;
 thermal-sensors = <&wkup_vtm0 4>;

 trips {
  main2_crit: main2-crit {
   temperature = <125000>;
