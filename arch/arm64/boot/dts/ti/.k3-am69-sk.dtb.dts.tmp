 usbss0: usb@4104000 {
  bootph-all;
  compatible = "ti,j721e-usb";
  reg = <0x00 0x4104000 0x00 0x100>;
  dma-coherent;
  power-domains = <&k3_pds 398 1>;
  clocks = <&k3_clks 398 21>, <&k3_clks 398 2>;
  clock-names = "ref", "lpm";
  assigned-clocks = <&k3_clks 398 21>;
  assigned-clock-parents = <&k3_clks 398 22>;
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

  status = "disabled";

  usb0: usb@6000000 {
   bootph-all;
   compatible = "cdns,usb3";
   reg = <0x00 0x6000000 0x00 0x10000>,
         <0x00 0x6010000 0x00 0x10000>,
         <0x00 0x6020000 0x00 0x10000>;
   reg-names = "otg", "xhci", "dev";
   interrupts = <0 96 4>,
         <0 102 4>,
         <0 120 4>;
   interrupt-names = "host",
       "peripheral",
       "otg";
  };
 };

