  status = "disabled";

  usb0: usb@31000000 {
   compatible = "snps,dwc3";
   reg = <0x00 0x31000000 0x00 0x50000>;
   interrupts = <0 188 4>,
         <0 188 4>;
   interrupt-names = "host", "peripheral";
   maximum-speed = "high-speed";
   dr_mode = "otg";
   snps,usb2-gadget-lpm-disable;
   snps,usb2-lpm-disable;
  };
 };

 usbss1: dwc3-usb@f910000 {
