  clocks = <&k3_clks 161 3>;
  clock-names = "ref";
  ti,syscon-phy-pll-refclk = <&usb0_phy_ctrl 0x0>;
  #address-cells = <2>;
  #size-cells = <2>;
  power-domains = <&k3_pds 178 1>;
