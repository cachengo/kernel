 pinctrl_wkup_uart0: wkup-uart0-default-pins {
  pinctrl-single,pins = <
   (((0x002c) & 0x1fff)) ((((1 << (18)) | (1 << (17) | (0 << (16))))) | (0))
   (((0x0030) & 0x1fff)) ((((0 << (18)) | (1 << (16)))) | (0))
   (((0x0024) & 0x1fff)) ((((1 << (18)) | (1 << (17) | (0 << (16))))) | (0))
   (((0x0028) & 0x1fff)) ((((0 << (18)) | (1 << (16)))) | (0))
  >;
 };
};


