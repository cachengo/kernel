/dts-v1/;

# 1 "arch/arm64/boot/dts/apple/t7001-air2.dtsi" 1






# 1 "arch/arm64/boot/dts/apple/t7001.dtsi" 1
# 9 "arch/arm64/boot/dts/apple/t7001.dtsi"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 10 "arch/arm64/boot/dts/apple/t7001.dtsi" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/apple-aic.h" 1




# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/irq.h" 1
# 6 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/apple-aic.h" 2
# 11 "arch/arm64/boot/dts/apple/t7001.dtsi" 2

# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/apple.h" 1
# 13 "arch/arm64/boot/dts/apple/t7001.dtsi" 2

/ {
 interrupt-parent = <&aic>;
 #address-cells = <2>;
 #size-cells = <2>;

 aliases {
  serial0 = &serial0;
 };

 clkref: clock-ref {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <24000000>;
  clock-output-names = "clkref";
 };

 cpus {
  #address-cells = <2>;
  #size-cells = <0>;

  cpu0: cpu@0 {
   compatible = "apple,typhoon";
   reg = <0x0 0x0>;
   cpu-release-addr = <0 0>;
   enable-method = "spin-table";
   device_type = "cpu";
  };

  cpu1: cpu@1 {
   compatible = "apple,typhoon";
   reg = <0x0 0x1>;
   cpu-release-addr = <0 0>;
   enable-method = "spin-table";
   device_type = "cpu";
  };

  cpu2: cpu@2 {
   compatible = "apple,typhoon";
   reg = <0x0 0x2>;
   cpu-release-addr = <0 0>;
   enable-method = "spin-table";
   device_type = "cpu";
  };
 };

 soc {
  compatible = "simple-bus";
  #address-cells = <2>;
  #size-cells = <2>;
  nonposted-mmio;
  ranges;

  serial0: serial@20a0c0000 {
   compatible = "apple,s5l-uart";
   reg = <0x2 0x0a0c0000 0x0 0x4000>;
   reg-io-width = <4>;
   interrupt-parent = <&aic>;
   interrupts = <0 158 4>;

   clocks = <&clkref>, <&clkref>;
   clock-names = "uart", "clk_uart_baud0";
   status = "disabled";
  };

  wdt: watchdog@20e027000 {
   compatible = "apple,t7000-wdt", "apple,wdt";
   reg = <0x2 0x0e027000 0x0 0x1000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 4 4>;
  };

  aic: interrupt-controller@20e100000 {
   compatible = "apple,t7000-aic", "apple,aic";
   reg = <0x2 0x0e100000 0x0 0x100000>;
   #interrupt-cells = <3>;
   interrupt-controller;
  };

  pinctrl: pinctrl@20e300000 {
   compatible = "apple,t7000-pinctrl", "apple,pinctrl";
   reg = <0x2 0x0e300000 0x0 0x100000>;

   gpio-controller;
   #gpio-cells = <2>;
   gpio-ranges = <&pinctrl 0 0 184>;
   apple,npins = <184>;

   interrupt-controller;
   #interrupt-cells = <2>;
   interrupt-parent = <&aic>;
   interrupts = <0 62 4>,
         <0 63 4>,
         <0 64 4>,
         <0 65 4>,
         <0 66 4>,
         <0 67 4>,
         <0 68 4>;
  };
 };

 timer {
  compatible = "arm,armv8-timer";
  interrupt-parent = <&aic>;
  interrupt-names = "phys", "virt";

  interrupts = <1 2 4>,
        <1 3 4>;
 };
};
# 8 "arch/arm64/boot/dts/apple/t7001-air2.dtsi" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h" 1
# 13 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/linux-event-codes.h" 1
# 14 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h" 2
# 9 "arch/arm64/boot/dts/apple/t7001-air2.dtsi" 2

/ {
 chassis-type = "tablet";

 chosen {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

  stdout-path = "serial0";

  framebuffer0: framebuffer@0 {
   compatible = "apple,simple-framebuffer", "simple-framebuffer";
   reg = <0 0 0 0>;

   status = "disabled";
  };
 };

 gpio-keys {
  compatible = "gpio-keys";

  button-home {
   label = "Home Button";
   gpios = <&pinctrl 0 1>;
   linux,code = <172>;
   wakeup-source;
  };

  button-power {
   label = "Power Button";
   gpios = <&pinctrl 1 1>;
   linux,code = <116>;
   wakeup-source;
  };

  button-volup {
   label = "Volume Up";
   gpios = <&pinctrl 92 1>;
   linux,code = <115>;
  };

  button-voldown {
   label = "Volume Down";
   gpios = <&pinctrl 93 1>;
   linux,code = <114>;
  };
 };

 memory@800000000 {
  device_type = "memory";
  reg = <0x8 0 0 0>;
 };

 reserved-memory {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;


 };
};

&serial0 {
 status = "okay";
};
# 10 "arch/arm64/boot/dts/apple/t7001-j81.dts" 2

/ {
 compatible = "apple,j81", "apple,t7001", "apple,arm-platform";
 model = "Apple iPad Air 2 (Wi-Fi)";
};
