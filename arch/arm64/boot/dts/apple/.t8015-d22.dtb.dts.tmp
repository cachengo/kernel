# 0 "arch/arm64/boot/dts/apple/t8015-d22.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/apple/t8015-d22.dts"






/dts-v1/;

# 1 "arch/arm64/boot/dts/apple/t8015-x.dtsi" 1







# 1 "arch/arm64/boot/dts/apple/t8015.dtsi" 1
# 10 "arch/arm64/boot/dts/apple/t8015.dtsi"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 11 "arch/arm64/boot/dts/apple/t8015.dtsi" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/apple-aic.h" 1




# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/irq.h" 1
# 6 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/apple-aic.h" 2
# 12 "arch/arm64/boot/dts/apple/t8015.dtsi" 2

# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/apple.h" 1
# 14 "arch/arm64/boot/dts/apple/t8015.dtsi" 2

/ {
 interrupt-parent = <&aic>;
 #address-cells = <2>;
 #size-cells = <2>;

 clkref: clock-ref {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <24000000>;
  clock-output-names = "clkref";
 };

 cpus {
  #address-cells = <2>;
  #size-cells = <0>;

  cpu-map {
   cluster0 {
    core0 {
     cpu = <&cpu_e0>;
    };
    core1 {
     cpu = <&cpu_e1>;
    };
    core2 {
     cpu = <&cpu_e2>;
    };
    core3 {
     cpu = <&cpu_e3>;
    };
   };

   cluster1 {
    core0 {
     cpu = <&cpu_p0>;
    };
    core1 {
     cpu = <&cpu_p1>;
    };
   };
  };

  cpu_e0: cpu@0 {
   compatible = "apple,mistral";
   reg = <0x0 0x0>;
   cpu-release-addr = <0 0>;
   enable-method = "spin-table";
   device_type = "cpu";
  };

  cpu_e1: cpu@1 {
   compatible = "apple,mistral";
   reg = <0x0 0x1>;
   cpu-release-addr = <0 0>;
   enable-method = "spin-table";
   device_type = "cpu";
  };

  cpu_e2: cpu@2 {
   compatible = "apple,mistral";
   reg = <0x0 0x2>;
   cpu-release-addr = <0 0>;
   enable-method = "spin-table";
   device_type = "cpu";
  };

  cpu_e3: cpu@3 {
   compatible = "apple,mistral";
   reg = <0x0 0x3>;
   cpu-release-addr = <0 0>;
   enable-method = "spin-table";
   device_type = "cpu";
  };

  cpu_p0: cpu@10004 {
   compatible = "apple,monsoon";
   reg = <0x0 0x10004>;
   cpu-release-addr = <0 0>;
   enable-method = "spin-table";
   device_type = "cpu";
  };

  cpu_p1: cpu@10005 {
   compatible = "apple,monsoon";
   reg = <0x0 0x10005>;
   cpu-release-addr = <0 0>;
   enable-method = "spin-table";
   device_type = "cpu";
  };
 };

 soc {
  compatible = "simple-bus";
  #address-cells = <2>;
  #size-cells = <2>;
  nonposted-mmio;
  ranges;

  serial0: serial@22e600000 {
   compatible = "apple,s5l-uart";
   reg = <0x2 0x2e600000 0x0 0x4000>;
   reg-io-width = <4>;
   interrupt-parent = <&aic>;
   interrupts = <0 282 4>;

   clocks = <&clkref>, <&clkref>;
   clock-names = "uart", "clk_uart_baud0";
   status = "disabled";
  };

  aic: interrupt-controller@232100000 {
   compatible = "apple,t8015-aic", "apple,aic";
   reg = <0x2 0x32100000 0x0 0x8000>;
   #interrupt-cells = <3>;
   interrupt-controller;
  };

  pinctrl_ap: pinctrl@233100000 {
   compatible = "apple,t8015-pinctrl", "apple,pinctrl";
   reg = <0x2 0x33100000 0x0 0x1000>;

   gpio-controller;
   #gpio-cells = <2>;
   gpio-ranges = <&pinctrl_ap 0 0 223>;
   apple,npins = <223>;

   interrupt-controller;
   #interrupt-cells = <2>;
   interrupt-parent = <&aic>;
   interrupts = <0 50 4>,
         <0 51 4>,
         <0 52 4>,
         <0 53 4>,
         <0 54 4>,
         <0 55 4>,
         <0 56 4>;
  };

  pinctrl_aop: pinctrl@2340f0000 {
   compatible = "apple,t8015-pinctrl", "apple,pinctrl";
   reg = <0x2 0x340f0000 0x0 0x4000>;

   gpio-controller;
   #gpio-cells = <2>;
   gpio-ranges = <&pinctrl_aop 0 0 49>;
   apple,npins = <49>;

   interrupt-controller;
   #interrupt-cells = <2>;
   interrupt-parent = <&aic>;
   interrupts = <0 135 4>,
         <0 136 4>,
         <0 137 4>,
         <0 138 4>,
         <0 139 4>,
         <0 140 4>,
         <0 141 4>;
  };

  pinctrl_nub: pinctrl@2351f0000 {
   compatible = "apple,t8015-pinctrl", "apple,pinctrl";
   reg = <0x2 0x351f0000 0x0 0x4000>;

   gpio-controller;
   #gpio-cells = <2>;
   gpio-ranges = <&pinctrl_nub 0 0 8>;
   apple,npins = <8>;

   interrupt-controller;
   #interrupt-cells = <2>;
   interrupt-parent = <&aic>;
   interrupts = <0 168 4>,
         <0 169 4>,
         <0 170 4>;
  };

  wdt: watchdog@2352b0000 {
   compatible = "apple,t8015-wdt", "apple,wdt";
   reg = <0x2 0x352b0000 0x0 0x4000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 172 4>;
  };

  pinctrl_smc: pinctrl@236024000 {
   compatible = "apple,t8015-pinctrl", "apple,pinctrl";
   reg = <0x2 0x36024000 0x0 0x4000>;

   gpio-controller;
   #gpio-cells = <2>;
   gpio-ranges = <&pinctrl_smc 0 0 6>;
   apple,npins = <6>;

   interrupt-controller;
   #interrupt-cells = <2>;
   interrupt-parent = <&aic>;
   interrupts = <0 199 4>,
         <0 200 4>,
         <0 201 4>,
         <0 202 4>,
         <0 203 4>,
         <0 204 4>,
         <0 205 4>;




   status = "disabled";
  };
 };

 timer {
  compatible = "arm,armv8-timer";
  interrupt-parent = <&aic>;
  interrupt-names = "phys", "virt";

  interrupts = <1 2 4>,
        <1 3 4>;
 };
};
# 9 "arch/arm64/boot/dts/apple/t8015-x.dtsi" 2
# 1 "arch/arm64/boot/dts/apple/t8015-common.dtsi" 1
# 12 "arch/arm64/boot/dts/apple/t8015-common.dtsi"
/ {
 aliases {
  serial0 = &serial0;
 };

 chosen {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

  stdout-path = "serial0";

  framebuffer0: framebuffer@0 {
   compatible = "apple,simple-framebuffer", "simple-framebuffer";
   reg = <0 0 0 0>;

   status = "disabled";
  };
 };

 memory@800000000 {
  device_type = "memory";
  reg = <0x8 0 0 0>;
 };

 reserved-memory {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;


 };
};

&serial0 {
 status = "okay";
};
# 10 "arch/arm64/boot/dts/apple/t8015-x.dtsi" 2

/ {
 chassis-type = "handset";
};
# 10 "arch/arm64/boot/dts/apple/t8015-d22.dts" 2

/ {
 compatible = "apple,d22", "apple,t8015", "apple,arm-platform";
 model = "Apple iPhone X (Global)";
};
