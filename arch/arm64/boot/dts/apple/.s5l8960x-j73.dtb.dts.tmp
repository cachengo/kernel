/dts-v1/;

# 1 "arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi" 1
# 9 "arch/arm64/boot/dts/apple/s5l8960x-air1.dtsi"
# 1 "arch/arm64/boot/dts/apple/s5l8960x.dtsi" 1
