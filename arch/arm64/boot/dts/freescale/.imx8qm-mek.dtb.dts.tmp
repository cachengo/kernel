# 635 "arch/arm64/boot/dts/freescale/imx8qm.dtsi" 2
# 1 "arch/arm64/boot/dts/freescale/imx8qm-ss-lvds.dtsi" 1






&qm_lvds0_lis_lpcg {
 clocks = <&lvds_ipg_clk>;
 clock-indices = <16>;
};

&qm_lvds0_pwm_lpcg {
 clocks = <&clk 267 2>,
   <&lvds_ipg_clk>;
 clock-indices = <0>, <16>;
};

&qm_lvds0_i2c0_lpcg {
 clocks = <&clk 268 2>,
   <&lvds_ipg_clk>;
 clock-indices = <0>, <16>;
};

&qm_pwm_lvds0 {
 clocks = <&qm_lvds0_pwm_lpcg 16>,
   <&qm_lvds0_pwm_lpcg 0>;
};

&qm_i2c0_lvds0 {
 clocks = <&qm_lvds0_i2c0_lpcg 0>,
   <&qm_lvds0_i2c0_lpcg 16>;
};

&lvds0_subsys {
 interrupt-parent = <&irqsteer_lvds0>;

 irqsteer_lvds0: interrupt-controller@56240000 {
  compatible = "fsl,imx8qm-irqsteer", "fsl,imx-irqsteer";
  reg = <0x56240000 0x1000>;
  interrupts = <0 57 4>;
  interrupt-controller;
  interrupt-parent = <&gic>;
  #interrupt-cells = <1>;
  clocks = <&qm_lvds0_lis_lpcg 16>;
  clock-names = "ipg";
  power-domains = <&pd 266>;

  fsl,channel = <0>;
  fsl,num-irqs = <32>;
 };

 lvds0_i2c1_lpcg: clock-controller@56243014 {
  compatible = "fsl,imx8qxp-lpcg";
  reg = <0x56243014 0x4>;
  #clock-cells = <1>;
  clocks = <&clk 268 2>,
    <&lvds_ipg_clk>;
  clock-indices = <0>, <16>;
  clock-output-names = "lvds0_i2c1_lpcg_clk",
         "lvds0_i2c1_lpcg_ipg_clk";
  power-domains = <&pd 268>;
 };

 i2c1_lvds0: i2c@56247000 {
  compatible = "fsl,imx8qm-lpi2c", "fsl,imx7ulp-lpi2c";
  reg = <0x56247000 0x1000>;
  interrupts = <9>;
  clocks = <&lvds0_i2c1_lpcg 0>,
    <&lvds0_i2c1_lpcg 16>;
  clock-names = "per", "ipg";
  assigned-clocks = <&clk 268 2>;
  assigned-clock-rates = <24000000>;
  power-domains = <&pd 268>;
  status = "disabled";
 };
};
