    <&clk_sai6_rx_bclk>;
  clock-names = "aud_rec_clk0_lpcg_clk",
         "aud_rec_clk1_lpcg_clk",
         "aud_pll_div_clk0_lpcg_clk",
         "aud_pll_div_clk1_lpcg_clk",
         "mlb_clk",
         "hdmi_rx_mclk",
         "ext_aud_mclk0",
         "ext_aud_mclk1",
         "esai0_rx_clk",
         "esai0_rx_hf_clk",
         "esai0_tx_clk",
         "esai0_tx_hf_clk",
         "esai1_rx_clk",
         "esai1_rx_hf_clk",
         "esai1_tx_clk",
         "esai1_tx_hf_clk",
         "spdif0_rx",
         "spdif1_rx",
         "sai0_rx_bclk",
         "sai0_tx_bclk",
         "sai1_rx_bclk",
         "sai1_tx_bclk",
         "sai2_rx_bclk",
         "sai3_rx_bclk",
         "sai4_rx_bclk",
         "sai5_tx_bclk",
         "sai6_rx_bclk";
 };
};

&dsp_lpcg {
 status = "disabled";
};

&dsp_ram_lpcg {
 status = "disabled";
};


&edma0 {
 reg = <0x591f0000 0x150000>;
 dma-channels = <20>;
 dma-channel-mask = <0>;
 interrupts = <0 374 4>,
       <0 375 4>,
       <0 376 4>,
       <0 377 4>,
       <0 378 4>,
       <0 379 4>,
       <0 410 4>,
       <0 410 4>,
       <0 457 4>,
