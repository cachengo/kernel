  clock-names = "per", "ipg";
  assigned-clocks = <&clk 54 2>;
  assigned-clock-rates = <60000000>;
  power-domains = <&pd 54>;
  dmas = <&edma2 3 0 0>, <&edma2 2 0 0x1>;
  dma-names = "tx", "rx";
  status = "disabled";
 };

