audio_subsys: bus@59000000 {
 compatible = "simple-bus";
 #address-cells = <1>;
 #size-cells = <1>;
 ranges = <0x59000000 0x0 0x59000000 0x1000000>;

 asrc0: asrc@59000000 {
  compatible = "fsl,imx8qm-asrc";
  reg = <0x59000000 0x10000>;
  interrupts = <0 372 4>;
  clocks = <&asrc0_lpcg 0>,
