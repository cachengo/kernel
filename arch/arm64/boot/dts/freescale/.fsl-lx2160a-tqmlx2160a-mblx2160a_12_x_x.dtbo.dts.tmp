# 0 "arch/arm64/boot/dts/freescale/fsl-lx2160a-tqmlx2160a-mblx2160a_12_x_x.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/freescale/fsl-lx2160a-tqmlx2160a-mblx2160a_12_x_x.dtso"







/dts-v1/;
/plugin/;

&dpmac9 {
 phy-handle = <&dp83867_2_1>;
 phy-connection-type = "sgmii";
 managed = "in-band-status";
};

&dpmac10 {
 phy-handle = <&dp83867_2_2>;
 phy-connection-type = "sgmii";
 managed = "in-band-status";
};

&pcs_mdio9 {
 status = "okay";
};

&pcs_mdio10 {
 status = "okay";
};
