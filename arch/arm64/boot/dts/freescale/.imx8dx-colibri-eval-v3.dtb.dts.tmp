# 8 "arch/arm64/boot/dts/freescale/imx8dx-colibri.dtsi" 2

/ {
 model = "Toradex Colibri iMX8DX Module";
};

&thermal_zones {
 pmic-thermal {
  cooling-maps {
   map0 {
    cooling-device = <&A35_0 (~0) (~0)>,
       <&A35_1 (~0) (~0)>;
   };
  };
 };
};
# 9 "arch/arm64/boot/dts/freescale/imx8dx-colibri-eval-v3.dts" 2
# 1 "arch/arm64/boot/dts/freescale/imx8x-colibri-eval-v3.dtsi" 1





# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/linux-event-codes.h" 1
# 7 "arch/arm64/boot/dts/freescale/imx8x-colibri-eval-v3.dtsi" 2

/ {
 aliases {
  rtc0 = &rtc_i2c;
  rtc1 = &rtc;
 };


 clk16m: clock-16mhz {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <16000000>;
 };
};


&adc0 {
 status = "okay";
};


&adma_pwm {
 status = "okay";
};

&colibri_gpio_keys {
 status = "okay";
};

&extcon_usbc_det {
 status = "okay";
};

&i2c1 {
 status = "okay";


 rtc_i2c: rtc@68 {
  compatible = "st,m41t0";
  reg = <0x68>;
 };
};

&iomuxc {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_ext_io0>, <&pinctrl_hog0>, <&pinctrl_hog1>,
      <&pinctrl_lpspi2_cs2>;
};


&lpspi2 {
 status = "okay";

 mcp2515: can@0 {
  compatible = "microchip,mcp2515";
  reg = <0>;
  interrupt-parent = <&lsio_gpio3>;
  interrupts = <13 2>;
  pinctrl-0 = <&pinctrl_can_int>;
  pinctrl-names = "default";
  clocks = <&clk16m>;
  spi-max-frequency = <10000000>;
 };
};


&lpuart0 {
 status = "okay";
};


&lpuart2 {
 status = "okay";
};


&lsio_pwm0 {
 status = "okay";
};


&lsio_pwm1 {
 status = "okay";
};


&lsio_pwm2 {
 status = "okay";
};


&lpuart3 {
 status = "okay";
};


&fec1 {
 status = "okay";
};


&usb3_phy {
 status = "okay";
};

&usbotg1 {
 status = "okay";
};

&usbotg3 {
 status = "okay";
};

&usbotg3_cdns3 {
 status = "okay";
};


&usbphy1 {
 status = "okay";
};


&usdhc2 {
 status = "okay";
};
# 10 "arch/arm64/boot/dts/freescale/imx8dx-colibri-eval-v3.dts" 2

/ {
 model = "Toradex Colibri iMX8DX on Colibri Evaluation Board V3";
 compatible = "toradex,colibri-imx8x-eval-v3",
       "toradex,colibri-imx8x",
       "fsl,imx8dx";
};
