    <&conn_axi_clk>,
    <&clk 252 24>,
    <&conn_ipg_clk>,
    <&conn_ipg_clk>;
  clock-indices = <0>, <4>,
    <8>, <12>,
    <16>, <20>;
  clock-output-names = "enet1_lpcg_timer_clk",
         "enet1_lpcg_txc_sampling_clk",
