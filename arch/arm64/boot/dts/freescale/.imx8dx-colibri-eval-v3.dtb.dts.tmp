# 338 "arch/arm64/boot/dts/freescale/imx8qxp.dtsi" 2
# 1 "arch/arm64/boot/dts/freescale/imx8qxp-ss-hsio.dtsi" 1






&hsio_subsys {
 phyx1_lpcg: clock-controller@5f090000 {
  compatible = "fsl,imx8qxp-lpcg";
  reg = <0x5f090000 0x10000>;
  clocks = <&hsio_refb_clk>, <&hsio_per_clk>,
    <&hsio_per_clk>, <&hsio_per_clk>;
  #clock-cells = <1>;
  clock-indices = <0>, <4>,
    <8>, <16>;
  clock-output-names = "hsio_phyx1_pclk",
         "hsio_phyx1_epcs_tx_clk",
         "hsio_phyx1_epcs_rx_clk",
         "hsio_phyx1_apb_clk";
  power-domains = <&pd 171>;
 };

 hsio_phy: phy@5f1a0000 {
  compatible = "fsl,imx8qxp-hsio";
  reg = <0x5f1a0000 0x10000>,
        <0x5f120000 0x10000>,
        <0x5f140000 0x10000>,
        <0x5f160000 0x10000>;
  reg-names = "reg", "phy", "ctrl", "misc";
  clocks = <&phyx1_lpcg 0>,
    <&phyx1_lpcg 4>,
    <&phyx1_crr1_lpcg 16>,
    <&pcieb_crr3_lpcg 16>,
    <&misc_crr5_lpcg 16>;
  clock-names = "pclk0", "apb_pclk0", "phy0_crr", "ctl0_crr",
         "misc_crr";
  #phy-cells = <3>;
  power-domains = <&pd 171>;
  status = "disabled";
 };
};
