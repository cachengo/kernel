# 0 "arch/arm64/boot/dts/freescale/imx8mp-aristainetos3-helios-lvds.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/freescale/imx8mp-aristainetos3-helios-lvds.dtso"




# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 6 "arch/arm64/boot/dts/freescale/imx8mp-aristainetos3-helios-lvds.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h" 1
# 13 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/linux-event-codes.h" 1
# 14 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h" 2
# 7 "arch/arm64/boot/dts/freescale/imx8mp-aristainetos3-helios-lvds.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/arm-gic.h" 1
# 9 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/arm-gic.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/irq.h" 1
# 10 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/arm-gic.h" 2
# 8 "arch/arm64/boot/dts/freescale/imx8mp-aristainetos3-helios-lvds.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pwm/pwm.h" 1
# 9 "arch/arm64/boot/dts/freescale/imx8mp-aristainetos3-helios-lvds.dtso" 2

/dts-v1/;
/plugin/;

&{/} {
 model = "Aristainetos3 helios carrier with LVDS";
 compatible = "abb,imx8mp-aristanetos3-helios",
       "abb,imx8mp-aristanetos3-som",
       "fsl,imx8mp";

 panel_lvds: panel-lvds {
  compatible = "lg,lb070wv8";
  power-supply = <&reg_vcc_disp>;
  backlight = <&lvds_backlight>;

  port {
   in_lvds0: endpoint {
    remote-endpoint = <&ldb_lvds_ch0>;
   };
  };
 };

 reg_vcc_disp: regulator-disp {
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_lcd0_vcc_en>;
  compatible = "regulator-fixed";
  regulator-name = "disp_power_en_2v8";
  regulator-min-microvolt = <2800000>;
  regulator-max-microvolt = <2800000>;
  gpio = <&gpio1 13 0>;
  enable-active-high;
  regulator-boot-on;
  regulator-always-on;
 };
};

&gpio3 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_gpio3_hog>;

 lvdssel-hog {
  gpio-hog;
  gpios = <23 0>;
  output-low;
  line-name = "LVDSSEL";
 };
};

&hdmi_blk_ctrl {
 status = "disabled";
};

&hdmi_pvi {
 status = "disabled";
};

&hdmi_tx {
 status = "disabled";
};

&hdmi_tx_phy {
 status = "disabled";
};

&irqsteer_hdmi {
 status = "disabled";
};

&ldb_lvds_ch0 {
 remote-endpoint = <&in_lvds0>;
};

&lcdif1 {
 status = "disabled";
};

&lcdif2 {
 status = "okay";
};

&lcdif3 {
 status = "disabled";
};

&lvds_backlight {
 status = "okay";
};

&lvds_bridge {

 assigned-clock-rates = <232820000>;
 status = "okay";
};

&media_blk_ctrl {




 assigned-clock-rates = <500000000>, <200000000>, <0>,

  <33260000>, <0>,

  <465640000>;
};
