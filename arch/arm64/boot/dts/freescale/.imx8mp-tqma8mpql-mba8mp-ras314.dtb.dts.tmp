      assigned-clock-parents = <&clk 56>,
          <&clk 56>;
      assigned-clock-rates = <400000000>,
               <800000000>;
     };

     pgc_gpu2d: power-domain@6 {
      #power-domain-cells = <0>;
      reg = <6>;
      clocks = <&clk 247>;
      power-domains = <&pgc_gpumix>;
     };

     pgc_gpumix: power-domain@7 {
      #power-domain-cells = <0>;
