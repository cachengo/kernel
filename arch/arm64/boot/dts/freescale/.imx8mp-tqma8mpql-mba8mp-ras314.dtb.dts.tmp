      clocks = <&clk 263>,
        <&clk 102>;
      assigned-clocks = <&clk 101>,
          <&clk 102>;
      assigned-clock-parents = <&clk 56>,
          <&clk 56>;
      assigned-clock-rates = <800000000>, <400000000>;
     };

     pgc_vpumix: power-domain@8 {
      #power-domain-cells = <0>;
      reg = <8>;
      clocks = <&clk 282>;
     };

     pgc_gpu3d: power-domain@9 {
      #power-domain-cells = <0>;
      reg = <9>;
      clocks = <&clk 248>,
        <&clk 308>;
