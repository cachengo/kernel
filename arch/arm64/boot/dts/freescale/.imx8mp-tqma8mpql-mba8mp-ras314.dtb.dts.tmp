 hub_2_0: hub@1 {
  compatible = "usb451,8142";
  reg = <1>;
  peer-hub = <&hub_3_0>;
  reset-gpios = <&gpio5 26 1>;
  vdd-supply = <&reg_vcc_3v3>;
 };

 hub_3_0: hub@2 {
  compatible = "usb451,8140";
  reg = <2>;
  peer-hub = <&hub_2_0>;
  reset-gpios = <&gpio5 26 1>;
  vdd-supply = <&reg_vcc_3v3>;
 };
};


