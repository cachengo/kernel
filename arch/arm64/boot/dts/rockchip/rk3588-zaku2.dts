/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include "rk3588.dtsi"

/ {
    model = "Radxa ZAKU2 V1.2";
	compatible = "radxa,zaku2", "rockchip,rk3588";

    aliases {
		mmc0 = &sdhci;
		mmc1 = &sdmmc;
		mmc2 = &sdio;
	};

    chosen {
		stdout-path = "serial2:1500000n8";
	};
    
    // Double check
    vcc3v3_pcie2x1l0: regulator-vcc3v3-pcie2x1l0 {
		compatible = "regulator-fixed"; 				
		enable-active-high;										
		gpios = <&gpio1 RK_PD2 GPIO_ACTIVE_HIGH>;							
		pinctrl-names = "default";						// ?	
		pinctrl-0 = <&pcie2_0_vcc3v3_en>;				// +-			
		regulator-name = "vcc3v3_pcie2x1l0";						
		regulator-always-on;							
		regulator-boot-on;								
		regulator-min-microvolt = <3300000>;							
		regulator-max-microvolt = <3300000>;								
		startup-delay-us = <50000>;								
		vin-supply = <&vcc5v0_sys>;							
	};

    // Doubble check
    vcc3v3_pcie30: regulator-vcc3v3-pcie30 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&gpio1 RK_PA4 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&pcie3_vcc3v3_en>;
		regulator-name = "vcc3v3_pcie30";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <5000>;
		vin-supply = <&vcc5v0_sys>;
		regulator-boot-on;   // New flag for rock-5b
		regulator-always-on; // New flag for rock-5b
	};

    vcc5v0_sys: regulator-vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

    vcc_1v1_nldo_s3: regulator-vcc-1v1-nldo-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v1_nldo_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		vin-supply = <&vcc5v0_sys>;
	};

    // M2 slot x2
    // Add new nodes vcc3v3_pcie30x2: vcc3v3-pcie2x1l2
    // ++
    vcc3v3_pcie30x2: regulator-vcc3v3-pcie2x1l2 {
        compatible = "regulator-fixed";
        regulator-name = "vcc3v3_pcie2x1l2";
        regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
        enable-active-high;
        regulator-boot-on;
        regulator-always-on;
        gpios = <&gpio1 RK_PB7 GPIO_ACTIVE_HIGH>;
        startup-delay-us = <5000>;
        vin-supply = <&vcc5v0_sys>;
        // pinctrl-names = "default";     // ??? new fields
		// pinctrl-0 = <&pci3x2_vcc3v3_en>;// ??? new fields
    };

    // Add new LEDs for ZAKU2
    // ++
    leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_rgb_b>;

		led_rgb_b {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio4 RK_PC1 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};
	};
};

&combphy0_ps {
	status = "okay";
};

&combphy1_ps {
	status = "okay";
};

// Double check cpu, but I think it same
&cpu_b0 {
	cpu-supply = <&vdd_cpu_big0_s0>;
};

&cpu_b1 {
	cpu-supply = <&vdd_cpu_big0_s0>;
};

&cpu_b2 {
	cpu-supply = <&vdd_cpu_big1_s0>;
};

&cpu_b3 {
	cpu-supply = <&vdd_cpu_big1_s0>;
};

&cpu_l0 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_l1 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_l2 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_l3 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

// ++
&gpu {
	mali-supply = <&vdd_gpu_s0>;
	status = "okay";
};

// Add &mdio1
&mdio1 {
	rgmii_phy1: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

// Add &gmac1
// Reveiw it
&gmac1 {
	status = "okay";
	phy-mode = "rgmii";
	clock_in_out = "output";

	snps,reset-gpio = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	// Reset time is 20ms, 100ms for rtl8211f
	snps,reset-delays-us = <0 20000 100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&gmac1_miim
		     &gmac1_tx_bus2
		     &gmac1_rx_bus2
		     &gmac1_rgmii_clk
		     &gmac1_rgmii_bus>;

	tx_delay = <0x3c>;
	rx_delay = <0x35>;

	phy-handle = <&rgmii_phy1>;
};

// Add &usb2phy0_grf

// Add &pcie3x2
// ++
&pcie3x2 {
    // pinctrl-names = "default";
    // pinctrl-0 = <&pcie3_rst>; // reveiw it
    reset-gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie30x2>;
    status = "okay";
};

