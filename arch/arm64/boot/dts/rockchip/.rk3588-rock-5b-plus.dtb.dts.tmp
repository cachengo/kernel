  #size-cells = <1>;

  u2phy3: usb2phy@c000 {
   compatible = "rockchip,rk3588-usb2phy";
   reg = <0xc000 0x10>;
   #clock-cells = <0>;
   clocks = <&cru 672>;
   clock-names = "phyclk";
   clock-output-names = "usb480m_phy3";
   interrupts = <0 392 4 0>;
   resets = <&cru 624>, <&cru 544>;
