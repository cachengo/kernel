  assigned-clock-rates =
   <1100000000>, <786432000>,
   <850000000>, <1188000000>,
   <702000000>,
   <400000000>, <500000000>,
   <800000000>, <100000000>,
   <400000000>, <100000000>,
   <200000000>, <500000000>,
   <375000000>, <150000000>,
   <200000000>;
  rockchip,grf = <&php_grf>;
  #clock-cells = <1>;
  #reset-cells = <1>;
 };

