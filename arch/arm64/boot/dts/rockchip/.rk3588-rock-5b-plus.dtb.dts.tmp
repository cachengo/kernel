 hdmi_receiver: hdmi_receiver@fdee0000 {
  compatible = "rockchip,rk3588-hdmirx-ctrler", "snps,dw-hdmi-rx";
  reg = <0x0 0xfdee0000 0x0 0x6000>;
  power-domains = <&power 26>;
