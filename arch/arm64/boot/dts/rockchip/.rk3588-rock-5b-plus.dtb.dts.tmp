 dfi: dfi@fe060000 {
  reg = <0x00 0xfe060000 0x00 0x10000>;
  compatible = "rockchip,rk3588-dfi";
  interrupts = <0 28 4 0>,
        <0 38 4 0>,
        <0 48 4 0>,
