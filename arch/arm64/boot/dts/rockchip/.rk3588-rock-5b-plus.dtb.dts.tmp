};

&usbdp_phy0 {
 status = "okay";

 mode-switch;
 orientation-switch;
 sbu1-dc-gpios = <&gpio0 20 0>;
 sbu2-dc-gpios = <&gpio0 21 0>;

 port {
  #address-cells = <1>;
  #size-cells = <0>;

  usbdp_phy0_orientation_switch: endpoint@0 {
   reg = <0>;
   remote-endpoint = <&usbc0_orien_sw>;
  };

  usbdp_phy0_dp_altmode_mux: endpoint@1 {
   reg = <1>;
   remote-endpoint = <&dp_altmode_mux>;
  };
 };
};

