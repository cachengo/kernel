 status = "okay";
};

&usb_host0_ehci {
 status = "okay";
};

&usb_host0_ohci {
 status = "okay";
};

&usb_host0_xhci {
 usb-role-switch;
 status = "okay";

 port {
  #address-cells = <1>;
  #size-cells = <0>;

  dwc3_0_role_switch: endpoint@0 {
   reg = <0>;
   remote-endpoint = <&usbc0_role_sw>;
  };
 };
};

