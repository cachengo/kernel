   };
   power-domain@30 {
    reg = <30>;
    clocks = <&cru 378>,
      <&cru 379>;
    pm_qos = <&qos_rga3_1>;
    #power-domain-cells = <0>;
   };
   power-domain@31 {
    reg = <31>;
    clocks = <&cru 343>,
      <&cru 396>,
      <&cru 704>,
      <&cru 397>,
      <&cru 398>,
      <&cru 399>,
      <&cru 400>,
      <&cru 401>;
    pm_qos = <&qos_usb3_0>,
      <&qos_usb3_1>,
      <&qos_usb2host_0>,
      <&qos_usb2host_1>;
    #power-domain-cells = <0>;
   };
   power-domain@33 {
    reg = <33>;
    clocks = <&cru 343>,
      <&cru 346>,
      <&cru 347>;
    #power-domain-cells = <0>;
   };
   power-domain@34 {
    reg = <34>;
    clocks = <&cru 343>,
      <&cru 346>,
      <&cru 347>;
    #power-domain-cells = <0>;
   };
   power-domain@37 {
    reg = <37>;
    clocks = <&cru 394>,
      <&cru 306>;
    pm_qos = <&qos_sdio>;
    #power-domain-cells = <0>;
   };
   power-domain@38 {
    reg = <38>;
    clocks = <&cru 52>,
      <&cru 53>;
    #power-domain-cells = <0>;
   };
   power-domain@40 {
    reg = <40>;
    pm_qos = <&qos_sdmmc>;
    #power-domain-cells = <0>;
   };
  };
 };

