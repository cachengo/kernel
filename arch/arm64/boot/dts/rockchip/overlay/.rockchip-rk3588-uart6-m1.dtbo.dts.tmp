# 0 "arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-uart6-m1.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-uart6-m1.dtso"
/dts-v1/;
/plugin/;

/ {
 fragment@0 {
  target = <&uart6>;

  __overlay__ {
   status = "okay";
   pinctrl-0 = <&uart6m1_xfer>;
  };
 };
};
