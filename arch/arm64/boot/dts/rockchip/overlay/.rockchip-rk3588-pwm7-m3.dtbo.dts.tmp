# 0 "arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-pwm7-m3.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-pwm7-m3.dtso"
/dts-v1/;
/plugin/;

/ {
 metadata {
  title = "Enable PWM7-M3";
  compatible = "radxa,rock-5b";
  category = "misc";
  exclusive = "GPIO4_C6";
  description = "Enable PWM7-M3.\nOn Radxa ROCK 5B this is pin 27.";
 };

 fragment@0 {
  target = <&pwm7>;

  __overlay__ {
   status = "okay";
   pinctrl-0 = <&pwm7m3_pins>;
  };
 };
};
