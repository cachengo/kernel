# 0 "arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-pwm14-m1.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-pwm14-m1.dtso"
/dts-v1/;
/plugin/;

/ {
 fragment@0 {
  target = <&pwm14>;

  __overlay__ {
   status = "okay";
   pinctrl-names = "active";
   pinctrl-0 = <&pwm14m1_pins>;
  };
 };
};
