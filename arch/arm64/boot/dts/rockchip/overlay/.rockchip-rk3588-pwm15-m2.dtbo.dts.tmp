# 0 "arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-pwm15-m2.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-pwm15-m2.dtso"
/dts-v1/;
/plugin/;

/ {
 fragment@0 {
  target = <&pwm15>;

  __overlay__ {
   status = "okay";
   pinctrl-0 = <&pwm15m2_pins>;
  };
 };
};
