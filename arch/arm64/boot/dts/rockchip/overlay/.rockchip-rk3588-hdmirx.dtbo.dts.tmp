# 0 "arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-hdmirx.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-hdmirx.dtso"
/dts-v1/;
/plugin/;

/ {
 fragment@0 {
  target = <&hdmi_receiver_cma>;

  __overlay__ {
   status = "okay";
  };
 };

 fragment@1 {
  target = <&hdmi_receiver>;

  __overlay__ {
   status = "okay";
  };
 };
};
