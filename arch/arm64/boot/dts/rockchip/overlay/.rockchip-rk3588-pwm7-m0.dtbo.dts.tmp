# 0 "arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-pwm7-m0.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-pwm7-m0.dtso"
/dts-v1/;
/plugin/;

/ {
 metadata {
  title = "Enable PWM7-M0";
  compatible = "radxa,rock-5a";
  category = "misc";
  exclusive = "GPIO0_D0";
  description = "Enable PWM7-M0.\nOn Radxa ROCK 5A this is pin 28.";
 };

 fragment@0 {
  target = <&pwm7>;

  __overlay__ {
   status = "okay";
   pinctrl-0 = <&pwm7m0_pins>;
  };
 };
};
