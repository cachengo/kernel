# 0 "arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-i2c8-m2.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-i2c8-m2.dtso"
/dts-v1/;
/plugin/;

/ {
 fragment@0 {
  target = <&i2c8>;

  __overlay__ {
   status = "okay";
   pinctrl-names = "default";
   pinctrl-0 = <&i2c8m2_xfer>;
  };
 };
};
