# 0 "arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-pwm6-m2.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-pwm6-m2.dtso"
/dts-v1/;
/plugin/;

/ {
 metadata {
  title = "Enable PWM6-M2";
  compatible = "radxa,rock-5b";
  category = "misc";
  exclusive = "GPIO4_C5";
  description = "Enable PWM6-M2.\nOn Radxa ROCK 5B this is pin 28.";
 };

 fragment@0 {
  target = <&pwm6>;

  __overlay__ {
   status = "okay";
   pinctrl-0 = <&pwm6m2_pins>;
  };
 };
};
