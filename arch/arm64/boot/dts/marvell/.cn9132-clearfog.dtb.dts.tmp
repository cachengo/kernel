      <&cp2_rsvd7_pins &cp2_rsvd10_pins &cp2_rsvd11_pins>,
      <&cp2_rsvd27_pins &cp2_rsvd31_pins &cp2_rsvd32_pins>,
      <&cp2_rsvd56_pins>;
};


&cp2_sata0 {
 status = "okay";


 /delete-node/ sata-port@0;

