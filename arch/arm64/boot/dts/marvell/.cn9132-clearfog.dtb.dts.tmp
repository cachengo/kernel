  };

  cp1_rsvd16_pins: cp1-rsvd16-pins {
   marvell,pins = "mpp29";
   marvell,function = "gpio";
  };

  cp1_sata_act_pins: cp1-sata-act-pins {
   marvell,pins = "mpp39";
   marvell,function = "gpio";
  };

  cp1_spi1_pins: cp1-spi1-pins {
