  };

  cp1_wake1_pins: cp1-wake1-pins {
   marvell,pins = "mpp51";
   marvell,function = "gpio";
  };

  cp1_xmdio_pins: cp1-xmdio-pins {
   marvell,pins = "mpp37", "mpp38";
   marvell,function = "xg";
  };
 };
};

