  dispcc: clock-controller@af00000 {
   compatible = "qcom,sa8775p-dispcc0";
   reg = <0x0 0x0af00000 0x0 0x20000>;
   clocks = <&gcc 22>,
     <&rpmhcc 0>,
     <&rpmhcc 1>,
     <&sleep_clk>,
     <0>, <0>, <0>, <0>,
     <0>, <0>, <0>, <0>;
   power-domains = <&rpmhpd 6>;
   #clock-cells = <1>;
   #reset-cells = <1>;
   #power-domain-cells = <1>;
  };

