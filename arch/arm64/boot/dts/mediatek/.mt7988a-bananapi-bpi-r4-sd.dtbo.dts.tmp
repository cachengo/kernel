# 0 "arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-sd.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-sd.dtso"






/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 11 "arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-sd.dtso" 2

/ {
 compatible = "bananapi,bpi-r4", "mediatek,mt7988a";
};

&{/soc/mmc@11230000} {
 pinctrl-names = "default", "state_uhs";
 pinctrl-0 = <&mmc0_pins_sdcard>;
 pinctrl-1 = <&mmc0_pins_sdcard>;
 cd-gpios = <&pio 12 1>;
 bus-width = <4>;
 max-frequency = <52000000>;
 cap-sd-highspeed;
 vmmc-supply = <&reg_3p3v>;
 vqmmc-supply = <&reg_3p3v>;
 no-mmc;
 #address-cells = <1>;
 #size-cells = <0>;
 status = "okay";
};
