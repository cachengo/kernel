 spi1_pins_sleep: spi1-sleep-pins {
  pins-bus {
   pinmux = <(((75) << 8) | 0)>,
     <(((76) << 8) | 0)>,
     <(((77) << 8) | 0)>,
     <(((78) << 8) | 0)>;
