  pcie: pcie@112f0000 {
   compatible = "mediatek,mt8188-pcie", "mediatek,mt8192-pcie";
   reg = <0 0x112f0000 0 0x2000>;
   reg-names = "pcie-mac";
   ranges = <0x82000000 0 0x20000000 0 0x20000000 0 0x4000000>;
   bus-range = <0 0xff>;
   device_type = "pci";
