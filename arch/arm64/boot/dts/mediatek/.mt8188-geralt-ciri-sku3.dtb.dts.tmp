  };
 };
};

&dp_tx {
 pinctrl-names = "default";
 pinctrl-0 = <&dp_tx_hpd>;
 #sound-dai-cells = <0>;
 status = "okay";

 ports {
  #address-cells = <1>;
  #size-cells = <0>;

  port@0 {
   reg = <0>;
   dptx_in: endpoint {
    remote-endpoint = <&dp_intf1_out>;
   };
  };

  port@1 {
   reg = <1>;
   dptx_out: endpoint {
    data-lanes = <0 1 2 3>;
   };
  };
 };
};

