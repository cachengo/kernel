        <&cpu3 (~0) (~0)>,
        <&cpu4 (~0) (~0)>,
        <&cpu5 (~0) (~0)>;
    };
   };
  };

  cpu-little3-thermal {
   polling-delay = <1000>;
   polling-delay-passive = <150>;
   thermal-sensors = <&lvts_mcu 3>;

   trips {
    cpu_little3_alert0: trip-alert0 {
     temperature = <85000>;
     hysteresis = <2000>;
     type = "passive";
    };

    cpu_little3_alert1: trip-alert1 {
