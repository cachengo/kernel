  cpu-big0-thermal {
   polling-delay = <1000>;
   polling-delay-passive = <100>;
   thermal-sensors = <&lvts_mcu 4>;

   trips {
    cpu_big0_alert0: trip-alert0 {
     temperature = <85000>;
     hysteresis = <2000>;
     type = "passive";
    };

    cpu_big0_alert1: trip-alert1 {
