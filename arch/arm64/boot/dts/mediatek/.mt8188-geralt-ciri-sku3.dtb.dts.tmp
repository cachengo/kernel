    };
   };

   cooling-maps {
    map0 {
     trip = <&cpu_big0_alert0>;
     cooling-device = <&cpu6 (~0) (~0)>,
        <&cpu7 (~0) (~0)>;
    };
   };
  };

  cpu-big1-thermal {
   polling-delay = <1000>;
   polling-delay-passive = <100>;
   thermal-sensors = <&lvts_mcu 5>;

   trips {
    cpu_big1_alert0: trip-alert0 {
     temperature = <85000>;
     hysteresis = <2000>;
