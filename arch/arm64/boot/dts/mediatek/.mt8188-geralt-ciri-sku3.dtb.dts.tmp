 adsp_uart_pins: adsp-uart-pins {
  pins-bus {
   pinmux = <(((35) << 8) | 3)>,
     <(((36) << 8) | 3)>;
  };
 };

 aud_etdm_hp_on: aud-etdm-hp-on-pins {
  pins-bus {
   pinmux = <(((110) << 8) | 1)>,
     <(((115) << 8) | 1)>,
     <(((116) << 8) | 1)>,
     <(((117) << 8) | 1)>;
  };
 };

 aud_etdm_hp_off: aud-etdm-hp-off-pins {
  pins-bus {
   pinmux = <(((110) << 8) | 0)>,
     <(((115) << 8) | 0)>,
     <(((116) << 8) | 0)>,
     <(((117) << 8) | 0)>;
   bias-pull-down;
   input-enable;
  };
 };

 aud_etdm_spk_on: aud-etdm-spk-on-pins {
