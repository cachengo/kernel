   interrupt-map = <0 0 0 1 &pcie_intc 0>,
     <0 0 0 2 &pcie_intc 1>,
     <0 0 0 3 &pcie_intc 2>,
     <0 0 0 4 &pcie_intc 3>;
   interrupt-map-mask = <0 0 0 7>;

   iommu-map = <0 &infra_iommu (((0) << 5) | (0)) 0xffff>;
   iommu-map-mask = <0>;

   phys = <&pcieport 2>;
   phy-names = "pcie-phy";

   power-domains = <&spm 5>;

   resets = <&watchdog 19>;
   reset-names = "mac";

   status = "disabled";

