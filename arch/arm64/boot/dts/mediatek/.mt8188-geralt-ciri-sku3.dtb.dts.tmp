   compatible = "mediatek,mt8188-disp-merge", "mediatek,mt8195-disp-merge";
   reg = <0 0x1c10c000 0 0x1000>;
   clocks = <&vdosys1 9>,
     <&vdosys1 24>;
   clock-names = "merge", "merge_async";
   interrupts = <0 503 4 0>;
   power-domains = <&spm 17>;
   resets = <&vdosys1 24>;
   mediatek,gce-client-reg = <&gce0 6 0xc000 0x1000>;
   mediatek,merge-mute;
  };

  merge2: merge@1c10d000 {
   compatible = "mediatek,mt8188-disp-merge", "mediatek,mt8195-disp-merge";
   reg = <0 0x1c10d000 0 0x1000>;
   clocks = <&vdosys1 10>,
     <&vdosys1 25>;
   clock-names = "merge", "merge_async";
   interrupts = <0 504 4 0>;
   power-domains = <&spm 17>;
   resets = <&vdosys1 25>;
   mediatek,gce-client-reg = <&gce0 6 0xd000 0x1000>;
   mediatek,merge-mute;
  };

  merge3: merge@1c10e000 {
   compatible = "mediatek,mt8188-disp-merge", "mediatek,mt8195-disp-merge";
   reg = <0 0x1c10e000 0 0x1000>;
   clocks = <&vdosys1 11>,
     <&vdosys1 26>;
   clock-names = "merge", "merge_async";
   interrupts = <0 505 4 0>;
   power-domains = <&spm 17>;
   resets = <&vdosys1 26>;
   mediatek,gce-client-reg = <&gce0 6 0xe000 0x1000>;
   mediatek,merge-mute;
  };

  merge4: merge@1c10f000 {
   compatible = "mediatek,mt8188-disp-merge", "mediatek,mt8195-disp-merge";
   reg = <0 0x1c10f000 0 0x1000>;
   clocks = <&vdosys1 12>,
     <&vdosys1 27>;
   clock-names = "merge", "merge_async";
   interrupts = <0 506 4 0>;
   power-domains = <&spm 17>;
   resets = <&vdosys1 27>;
   mediatek,gce-client-reg = <&gce0 6 0xf000 0x1000>;
   mediatek,merge-mute;
  };

  merge5: merge@1c110000 {
   compatible = "mediatek,mt8188-disp-merge", "mediatek,mt8195-disp-merge";
   reg = <0 0x1c110000 0 0x1000>;
   clocks = <&vdosys1 13>,
     <&vdosys1 28>;
   clock-names = "merge", "merge_async";
   interrupts = <0 507 4 0>;
   power-domains = <&spm 17>;
   resets = <&vdosys1 28>;
   mediatek,gce-client-reg = <&gce0 7 0x0000 0x1000>;
   mediatek,merge-fifo-en;
  };

  dp_intf1: dp-intf@1c113000 {
   compatible = "mediatek,mt8188-dp-intf";
   reg = <0 0x1c113000 0 0x1000>;
   clocks = <&vdosys1 58>,
     <&vdosys1 21>,
     <&apmixedsys 3>;
   clock-names = "pixel", "engine", "pll";
   interrupts = <0 513 4 0>;
   power-domains = <&spm 17>;
   status = "disabled";
  };

  ethdr0: ethdr@1c114000 {
   compatible = "mediatek,mt8188-disp-ethdr", "mediatek,mt8195-disp-ethdr";
   reg = <0 0x1c114000 0 0x1000>,
         <0 0x1c115000 0 0x1000>,
         <0 0x1c117000 0 0x1000>,
         <0 0x1c119000 0 0x1000>,
         <0 0x1c11a000 0 0x1000>,
         <0 0x1c11b000 0 0x1000>,
         <0 0x1c11c000 0 0x1000>;
   reg-names = "mixer", "vdo_fe0", "vdo_fe1", "gfx_fe0", "gfx_fe1",
        "vdo_be", "adl_ds";

   clocks = <&vdosys1 48>,
     <&vdosys1 43>,
     <&vdosys1 46>,
     <&vdosys1 44>,
     <&vdosys1 47>,
     <&vdosys1 45>,
     <&vdosys1 60>,
     <&vdosys1 49>,
     <&vdosys1 50>,
     <&vdosys1 51>,
     <&vdosys1 52>,
     <&vdosys1 53>,
     <&topckgen 5>;
   clock-names = "mixer", "vdo_fe0", "vdo_fe1", "gfx_fe0", "gfx_fe1",
          "vdo_be", "adl_ds", "vdo_fe0_async", "vdo_fe1_async",
          "gfx_fe0_async", "gfx_fe1_async", "vdo_be_async", "ethdr_top";

   interrupts = <0 566 4 0>;
   iommus = <&vpp_iommu (((3) << 5) | (4))>,
     <&vpp_iommu (((3) << 5) | (5))>;
   power-domains = <&spm 17>;
   resets = <&vdosys1 49>,
     <&vdosys1 50>,
     <&vdosys1 51>,
     <&vdosys1 52>,
     <&vdosys1 53>;

   mediatek,gce-client-reg = <&gce0 7 0x4000 0x1000>,
        <&gce0 7 0x5000 0x1000>,
        <&gce0 7 0x7000 0x1000>,
        <&gce0 7 0x9000 0x1000>,
        <&gce0 7 0xa000 0x1000>,
        <&gce0 7 0xb000 0x1000>,
        <&gce0 7 0xc000 0x1000>;
  };

  padding0: padding@1c11d000 {
   compatible = "mediatek,mt8188-disp-padding";
   reg = <0 0x1c11d000 0 0x1000>;
   clocks = <&vdosys1 31>;
   power-domains = <&spm 17>;
   mediatek,gce-client-reg = <&gce0 7 0xd000 0x1000>;
  };

  padding1: padding@1c11e000 {
   compatible = "mediatek,mt8188-disp-padding";
   reg = <0 0x1c11e000 0 0x1000>;
   clocks = <&vdosys1 32>;
   power-domains = <&spm 17>;
   mediatek,gce-client-reg = <&gce0 7 0xe000 0x1000>;
  };

  padding2: padding@1c11f000 {
   compatible = "mediatek,mt8188-disp-padding";
   reg = <0 0x1c11f000 0 0x1000>;
   clocks = <&vdosys1 33>;
   power-domains = <&spm 17>;
   mediatek,gce-client-reg = <&gce0 7 0xf000 0x1000>;
  };

  padding3: padding@1c120000 {
   compatible = "mediatek,mt8188-disp-padding";
   reg = <0 0x1c120000 0 0x1000>;
   clocks = <&vdosys1 34>;
   power-domains = <&spm 17>;
   mediatek,gce-client-reg = <&gce0 8 0x0000 0x1000>;
  };

  padding4: padding@1c121000 {
   compatible = "mediatek,mt8188-disp-padding";
   reg = <0 0x1c121000 0 0x1000>;
   clocks = <&vdosys1 35>;
   power-domains = <&spm 17>;
   mediatek,gce-client-reg = <&gce0 8 0x1000 0x1000>;
  };

  padding5: padding@1c122000 {
   compatible = "mediatek,mt8188-disp-padding";
   reg = <0 0x1c122000 0 0x1000>;
   clocks = <&vdosys1 36>;
   power-domains = <&spm 17>;
   mediatek,gce-client-reg = <&gce0 8 0x2000 0x1000>;
  };

  padding6: padding@1c123000 {
   compatible = "mediatek,mt8188-disp-padding";
   reg = <0 0x1c123000 0 0x1000>;
   clocks = <&vdosys1 37>;
   power-domains = <&spm 17>;
   mediatek,gce-client-reg = <&gce0 8 0x3000 0x1000>;
  };

  padding7: padding@1c124000 {
   compatible = "mediatek,mt8188-disp-padding";
   reg = <0 0x1c124000 0 0x1000>;
   clocks = <&vdosys1 38>;
   power-domains = <&spm 17>;
   mediatek,gce-client-reg = <&gce0 8 0x4000 0x1000>;
  };

  edp_tx: edp-tx@1c500000 {
   compatible = "mediatek,mt8188-edp-tx";
   reg = <0 0x1c500000 0 0x8000>;
   interrupts = <0 676 4 0>;
   nvmem-cells = <&dp_calib_data>;
   nvmem-cell-names = "dp_calibration_data";
   power-domains = <&spm 19>;
   max-linkrate-mhz = <8100>;
   status = "disabled";
  };

  dp_tx: dp-tx@1c600000 {
   compatible = "mediatek,mt8188-dp-tx";
   reg = <0 0x1c600000 0 0x8000>;
   interrupts = <0 458 4 0>;
   nvmem-cells = <&dp_calib_data>;
   nvmem-cell-names = "dp_calibration_data";
   power-domains = <&spm 18>;
   max-linkrate-mhz = <5400>;
   status = "disabled";
  };
 };
};
# 8 "arch/arm64/boot/dts/mediatek/mt8188-geralt.dtsi" 2
# 1 "arch/arm64/boot/dts/mediatek/mt6359.dtsi" 1





&pwrap {
 pmic: pmic {
  compatible = "mediatek,mt6359";
  interrupt-controller;
  #interrupt-cells = <2>;
  #sound-dai-cells = <1>;

  pmic_adc: adc {
   compatible = "mediatek,mt6359-auxadc";
   #io-channel-cells = <1>;
  };

  mt6359codec: audio-codec {
   compatible = "mediatek,mt6359-codec";
  };

  regulators {
   mt6359_vs1_buck_reg: buck_vs1 {
    regulator-name = "vs1";
    regulator-min-microvolt = <800000>;
    regulator-max-microvolt = <2200000>;
    regulator-enable-ramp-delay = <0>;
    regulator-always-on;
   };
   mt6359_vgpu11_buck_reg: buck_vgpu11 {
    regulator-name = "vgpu11";
    regulator-min-microvolt = <400000>;
    regulator-max-microvolt = <1193750>;
    regulator-ramp-delay = <5000>;
    regulator-enable-ramp-delay = <200>;
    regulator-allowed-modes = <0 1 2>;
   };
   mt6359_vmodem_buck_reg: buck_vmodem {
    regulator-name = "vmodem";
    regulator-min-microvolt = <400000>;
    regulator-max-microvolt = <1100000>;
    regulator-ramp-delay = <10760>;
    regulator-enable-ramp-delay = <200>;
   };
   mt6359_vpu_buck_reg: buck_vpu {
    regulator-name = "vpu";
    regulator-min-microvolt = <400000>;
    regulator-max-microvolt = <1193750>;
    regulator-ramp-delay = <5000>;
    regulator-enable-ramp-delay = <200>;
    regulator-allowed-modes = <0 1 2>;
   };
   mt6359_vcore_buck_reg: buck_vcore {
    regulator-name = "vcore";
    regulator-min-microvolt = <400000>;
    regulator-max-microvolt = <1300000>;
    regulator-ramp-delay = <5000>;
    regulator-enable-ramp-delay = <200>;
    regulator-allowed-modes = <0 1 2>;
   };
   mt6359_vs2_buck_reg: buck_vs2 {
    regulator-name = "vs2";
    regulator-min-microvolt = <800000>;
    regulator-max-microvolt = <1600000>;
    regulator-enable-ramp-delay = <0>;
    regulator-always-on;
   };
   mt6359_vpa_buck_reg: buck_vpa {
    regulator-name = "vpa";
    regulator-min-microvolt = <500000>;
    regulator-max-microvolt = <3650000>;
    regulator-enable-ramp-delay = <300>;
   };
   mt6359_vproc2_buck_reg: buck_vproc2 {
