 wakeup-event-action = <0x00>;
};

&pio {
 anx7625_pins: anx7625-pins {
  pins-int {
   pinmux = <(((9) << 8) | 0)>;
   input-enable;
   bias-disable;
  };

  pins-reset {
   pinmux = <(((98) << 8) | 0)>;
   output-low;
  };

  pins-power-en {
   pinmux = <(((96) << 8) | 0)>;
   output-low;
  };
 };

 en_pp1000_edpbrdg: pp1000-edpbrdg-en-pins {
  pins-vreg-en {
   pinmux = <(((29) << 8) | 0)>;
   output-low;
  };
 };

 en_pp1800_edpbrdg: pp1800-edpbrdg-en-pins {
  pins-vreg-en {
   pinmux = <(((30) << 8) | 0)>;
   output-low;
  };
 };

 en_pp3300_edpbrdg: pp3300-edpbrdg-en-pins {
  pins-vreg-en {
   pinmux = <(((31) << 8) | 0)>;
   output-low;
  };
 };

 touch_pin_report: pin-report-pins {
  pins-touch-en {
   pinmux = <(((37) << 8) | 0)>;
   output-low;
  };
 };
};

&sound {
 compatible = "mediatek,mt8186-mt6366-rt5650-sound";
 model = "mt8186_rt5650";
 mediatek,adsp = <&adsp>;

 audio-routing =
  "Headphone", "HPOL",
  "Headphone", "HPOR",
  "IN1P", "Headset Mic",
  "IN1N", "Headset Mic",
  "Speakers", "SPOL",
  "Speakers", "SPOR",
  "HDMI1", "TX";

 hs-playback-dai-link {
  codec {
   sound-dai = <&rt5650>;
  };
 };

 hs-capture-dai-link {
  codec {
   sound-dai = <&rt5650>;
  };
 };

 spk-share-dai-link {
 };

 spk-hdmi-playback-dai-link {
  codec {
   sound-dai = <&it6505dptx>;
  };
 };
};

&touchscreen_pins {
 /delete-node/ pins-report-sw;
};

&wifi_enable_pin {
 pins-wifi-enable {
  pinmux = <(((51) << 8) | 0)>;
 };
};

&wifi_pwrseq {
 reset-gpios = <&pio 51 1>;
};
# 8 "arch/arm64/boot/dts/mediatek/mt8186-corsola-chinchou-sku0.dts" 2

/ {
 model = "Google chinchou CZ1104CM2A/CZ1204CM2A";
 compatible = "google,chinchou-sku0", "google,chinchou-sku2",
   "google,chinchou-sku4", "google,chinchou-sku5",
   "google,chinchou", "mediatek,mt8186";
};

&gpio_keys {
 status = "disabled";
};
