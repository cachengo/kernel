  };

  cci_opp_14: opp-1330000000 {
   opp-hz = /bits/ 64 <1330000000>;
   opp-microvolt = <993750>;
  };

  cci_opp_15: opp-1400000000 {
   opp-hz = /bits/ 64 <1400000000>;
