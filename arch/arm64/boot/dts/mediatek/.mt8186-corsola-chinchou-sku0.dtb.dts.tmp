    reg = <0x1cc 0x14>;
   };

   lvts_efuse_data2: lvts2-calib@2f8 {
    reg = <0x2f8 0x14>;
   };

   svs_calibration: calib@550 {
    reg = <0x550 0x50>;
   };

   gpu_speedbin: gpu-speedbin@59c {
    reg = <0x59c 0x4>;
    bits = <0 3>;
   };

   socinfo-data1@7a0 {
    reg = <0x7a0 0x4>;
   };
