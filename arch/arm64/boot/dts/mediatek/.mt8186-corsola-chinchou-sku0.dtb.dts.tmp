   bias-disable;
   input-enable;
  };
 };

 spi2_pins: spi2-pins {
  pins-bus {
   pinmux = <(((44) << 8) | 1)>,
     <(((45) << 8) | 0)>,
     <(((46) << 8) | 1)>,
     <(((47) << 8) | 1)>;
   bias-disable;
   input-enable;
  };
 };

 spmi_pins: spmi-pins {
  pins-bus {
   pinmux = <(((183) << 8) | 1)>,
     <(((184) << 8) | 1)>;
  };
 };

 touchscreen_pins: touchscreen-pins {
  pins-irq {
   pinmux = <(((12) << 8) | 0)>;
   input-enable;
   bias-pull-up;
  };

  pins-reset {
   pinmux = <(((60) << 8) | 0)>;
   output-high;
  };

  pins-report-sw {
   pinmux = <(((37) << 8) | 0)>;
   output-low;
  };
 };

 trackpad_pin: trackpad-default-pins {
  pins-int-n {
   pinmux = <(((11) << 8) | 0)>;
   input-enable;
   bias-disable;
  };
 };

 wifi_enable_pin: wifi-enable-pins {
  pins-wifi-enable {
   pinmux = <(((54) << 8) | 0)>;
  };
 };

 wifi_wakeup_pin: wifi-wakeup-pins {
  pins-wifi-wakeup {
   pinmux = <(((7) << 8) | 0)>;
   input-enable;
  };
 };
};

&pwm0 {
 pinctrl-names = "default";
 pinctrl-0 = <&pwm0_pin>;
 status = "okay";
};

