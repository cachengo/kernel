&pinctrl {
 eth2_rgmii_pins_a: eth2-rgmii-0 {
  pins1 {
   pinmux = <(((((('C') - 'A') * 0x10 + (7))) << 8) | (0xb))>,
     <(((((('C') - 'A') * 0x10 + (8))) << 8) | (0xb))>,
     <(((((('C') - 'A') * 0x10 + (9))) << 8) | (0xb))>,
     <(((((('C') - 'A') * 0x10 + (10))) << 8) | (0xb))>,
     <(((((('C') - 'A') * 0x10 + (4))) << 8) | (0xb))>;
   bias-disable;
   drive-push-pull;
   slew-rate = <3>;
  };
  pins2 {
   pinmux = <(((((('F') - 'A') * 0x10 + (8))) << 8) | (0xb))>,
     <(((((('F') - 'A') * 0x10 + (7))) << 8) | (0xb))>,
     <(((((('C') - 'A') * 0x10 + (6))) << 8) | (0xb))>;
   bias-disable;
   drive-push-pull;
   slew-rate = <3>;
  };
  pins3 {
   pinmux = <(((((('C') - 'A') * 0x10 + (5))) << 8) | (0xb))>;
   bias-disable;
   drive-push-pull;
   slew-rate = <0>;
  };
  pins4 {
   pinmux = <(((((('G') - 'A') * 0x10 + (0))) << 8) | (0xb))>,
     <(((((('C') - 'A') * 0x10 + (12))) << 8) | (0xb))>,
     <(((((('F') - 'A') * 0x10 + (9))) << 8) | (0xb))>,
     <(((((('C') - 'A') * 0x10 + (11))) << 8) | (0xb))>,
     <(((((('C') - 'A') * 0x10 + (3))) << 8) | (0xb))>;
   bias-disable;
  };
  pins5 {
   pinmux = <(((((('F') - 'A') * 0x10 + (6))) << 8) | (0xb))>;
   bias-disable;
  };
 };

 eth2_rgmii_sleep_pins_a: eth2-rgmii-sleep-0 {
  pins {
   pinmux = <(((((('C') - 'A') * 0x10 + (7))) << 8) | (0x11))>,
     <(((((('C') - 'A') * 0x10 + (8))) << 8) | (0x11))>,
     <(((((('C') - 'A') * 0x10 + (9))) << 8) | (0x11))>,
     <(((((('C') - 'A') * 0x10 + (10))) << 8) | (0x11))>,
     <(((((('C') - 'A') * 0x10 + (4))) << 8) | (0x11))>,
     <(((((('F') - 'A') * 0x10 + (8))) << 8) | (0x11))>,
     <(((((('F') - 'A') * 0x10 + (7))) << 8) | (0x11))>,
     <(((((('C') - 'A') * 0x10 + (6))) << 8) | (0x11))>,
     <(((((('C') - 'A') * 0x10 + (5))) << 8) | (0x11))>,
     <(((((('G') - 'A') * 0x10 + (0))) << 8) | (0x11))>,
     <(((((('C') - 'A') * 0x10 + (12))) << 8) | (0x11))>,
     <(((((('F') - 'A') * 0x10 + (9))) << 8) | (0x11))>,
     <(((((('C') - 'A') * 0x10 + (11))) << 8) | (0x11))>,
     <(((((('C') - 'A') * 0x10 + (3))) << 8) | (0x11))>,
     <(((((('F') - 'A') * 0x10 + (6))) << 8) | (0x11))>;
  };
 };

 i2c2_pins_a: i2c2-0 {
  pins {
   pinmux = <(((((('B') - 'A') * 0x10 + (5))) << 8) | (0xa))>,
     <(((((('B') - 'A') * 0x10 + (4))) << 8) | (0xa))>;
   bias-disable;
   drive-open-drain;
   slew-rate = <0>;
  };
 };

 i2c2_sleep_pins_a: i2c2-sleep-0 {
  pins {
   pinmux = <(((((('B') - 'A') * 0x10 + (5))) << 8) | (0x11))>,
     <(((((('B') - 'A') * 0x10 + (4))) << 8) | (0x11))>;
  };
 };

 sdmmc1_b4_pins_a: sdmmc1-b4-0 {
  pins1 {
   pinmux = <(((((('E') - 'A') * 0x10 + (4))) << 8) | (0xb))>,
     <(((((('E') - 'A') * 0x10 + (5))) << 8) | (0xb))>,
     <(((((('E') - 'A') * 0x10 + (0))) << 8) | (0xb))>,
     <(((((('E') - 'A') * 0x10 + (1))) << 8) | (0xb))>,
     <(((((('E') - 'A') * 0x10 + (2))) << 8) | (0xb))>;
   slew-rate = <2>;
   drive-push-pull;
   bias-disable;
  };
  pins2 {
   pinmux = <(((((('E') - 'A') * 0x10 + (3))) << 8) | (0xb))>;
   slew-rate = <3>;
   drive-push-pull;
   bias-disable;
  };
 };

 sdmmc1_b4_od_pins_a: sdmmc1-b4-od-0 {
  pins1 {
   pinmux = <(((((('E') - 'A') * 0x10 + (4))) << 8) | (0xb))>,
     <(((((('E') - 'A') * 0x10 + (5))) << 8) | (0xb))>,
     <(((((('E') - 'A') * 0x10 + (0))) << 8) | (0xb))>,
     <(((((('E') - 'A') * 0x10 + (1))) << 8) | (0xb))>;
   slew-rate = <2>;
   drive-push-pull;
   bias-disable;
  };
  pins2 {
   pinmux = <(((((('E') - 'A') * 0x10 + (3))) << 8) | (0xb))>;
   slew-rate = <3>;
   drive-push-pull;
   bias-disable;
  };
  pins3 {
   pinmux = <(((((('E') - 'A') * 0x10 + (2))) << 8) | (0xb))>;
   slew-rate = <2>;
   drive-open-drain;
   bias-disable;
  };
 };

 sdmmc1_b4_sleep_pins_a: sdmmc1-b4-sleep-0 {
  pins {
   pinmux = <(((((('E') - 'A') * 0x10 + (4))) << 8) | (0x11))>,
     <(((((('E') - 'A') * 0x10 + (5))) << 8) | (0x11))>,
     <(((((('E') - 'A') * 0x10 + (0))) << 8) | (0x11))>,
     <(((((('E') - 'A') * 0x10 + (1))) << 8) | (0x11))>,
     <(((((('E') - 'A') * 0x10 + (3))) << 8) | (0x11))>,
     <(((((('E') - 'A') * 0x10 + (2))) << 8) | (0x11))>;
  };
 };

 spi3_pins_a: spi3-0 {
  pins1 {
   pinmux = <(((((('B') - 'A') * 0x10 + (7))) << 8) | (0x2))>,
     <(((((('B') - 'A') * 0x10 + (8))) << 8) | (0x2))>;
   drive-push-pull;
   bias-disable;
   slew-rate = <1>;
  };
  pins2 {
   pinmux = <(((((('B') - 'A') * 0x10 + (10))) << 8) | (0x2))>;
   bias-disable;
  };
 };

 spi3_sleep_pins_a: spi3-sleep-0 {
  pins1 {
   pinmux = <(((((('B') - 'A') * 0x10 + (7))) << 8) | (0x11))>,
     <(((((('B') - 'A') * 0x10 + (8))) << 8) | (0x11))>,
     <(((((('B') - 'A') * 0x10 + (10))) << 8) | (0x11))>;
  };
 };

 usart2_pins_a: usart2-0 {
  pins1 {
   pinmux = <(((((('A') - 'A') * 0x10 + (4))) << 8) | (0x7))>;
   bias-disable;
   drive-push-pull;
   slew-rate = <0>;
  };
  pins2 {
   pinmux = <(((((('A') - 'A') * 0x10 + (8))) << 8) | (0x9))>;
   bias-disable;
  };
 };

 usart2_idle_pins_a: usart2-idle-0 {
  pins1 {
   pinmux = <(((((('A') - 'A') * 0x10 + (4))) << 8) | (0x11))>;
  };
  pins2 {
   pinmux = <(((((('A') - 'A') * 0x10 + (8))) << 8) | (0x9))>;
   bias-disable;
  };
 };

 usart2_sleep_pins_a: usart2-sleep-0 {
  pins {
   pinmux = <(((((('A') - 'A') * 0x10 + (4))) << 8) | (0x11))>,
     <(((((('A') - 'A') * 0x10 + (8))) << 8) | (0x11))>;
  };
 };

 usart6_pins_a: usart6-0 {
  pins1 {
   pinmux = <(((((('F') - 'A') * 0x10 + (13))) << 8) | (0x4))>,
     <(((((('G') - 'A') * 0x10 + (5))) << 8) | (0x4))>;
   bias-disable;
   drive-push-pull;
   slew-rate = <0>;
  };
  pins2 {
   pinmux = <(((((('F') - 'A') * 0x10 + (14))) << 8) | (0x4))>,
     <(((((('F') - 'A') * 0x10 + (15))) << 8) | (0x4))>;
   bias-pull-up;
  };
 };

 usart6_idle_pins_a: usart6-idle-0 {
  pins1 {
   pinmux = <(((((('F') - 'A') * 0x10 + (13))) << 8) | (0x11))>,
     <(((((('F') - 'A') * 0x10 + (15))) << 8) | (0x11))>;
  };
  pins2 {
   pinmux = <(((((('G') - 'A') * 0x10 + (5))) << 8) | (0x4))>;
   bias-disable;
   drive-push-pull;
   slew-rate = <0>;
  };
  pins3 {
   pinmux = <(((((('F') - 'A') * 0x10 + (14))) << 8) | (0x4))>;
   bias-pull-up;
  };
 };

 usart6_sleep_pins_a: usart6-sleep-0 {
  pins {
   pinmux = <(((((('F') - 'A') * 0x10 + (13))) << 8) | (0x11))>,
     <(((((('G') - 'A') * 0x10 + (5))) << 8) | (0x11))>,
     <(((((('F') - 'A') * 0x10 + (15))) << 8) | (0x11))>,
     <(((((('F') - 'A') * 0x10 + (14))) << 8) | (0x11))>;
  };
 };
};

&pinctrl_z {
 i2c8_pins_a: i2c8-0 {
  pins {
   pinmux = <(((((('Z') - 'A') * 0x10 + (4))) << 8) | (0x9))>,
     <(((((('Z') - 'A') * 0x10 + (3))) << 8) | (0x9))>;
   bias-disable;
   drive-open-drain;
   slew-rate = <0>;
  };
 };

 i2c8_sleep_pins_a: i2c8-sleep-0 {
