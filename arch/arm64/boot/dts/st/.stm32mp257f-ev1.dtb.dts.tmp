    <&scmi_clk 61>,
    <&scmi_clk 62>,
    <&scmi_clk 63>,
    <&scmi_clk 77>,
    <&scmi_clk 78>,
    <&scmi_clk 79>,
    <&scmi_clk 80>,
    <&scmi_clk 81>,
    <&scmi_clk 82>,
    <&scmi_clk 83>,
    <&scmi_clk 74>,
    <&clk_dsi_txbyte>;
    access-controllers = <&rifsc 156>;
  };

  exti1: interrupt-controller@44220000 {
   compatible = "st,stm32mp1-exti", "syscon";
   interrupt-controller;
   #interrupt-cells = <2>;
   reg = <0x44220000 0x400>;
   interrupts-extended =
    <&intc 0 268 4>,
    <&intc 0 269 4>,
    <&intc 0 270 4>,
    <&intc 0 271 4>,
    <&intc 0 272 4>,
    <&intc 0 273 4>,
    <&intc 0 274 4>,
    <&intc 0 275 4>,
