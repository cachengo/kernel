    <&intc 0 248 4>,
    <&intc 0 249 4>,
    <&intc 0 256 4>,
    <0>,
    <0>,
    <&intc 0 213 4>;
  };
 };
};
# 7 "arch/arm64/boot/dts/st/stm32mp253.dtsi" 2

/ {
 cpus {
  cpu1: cpu@1 {
   compatible = "arm,cortex-a35";
   device_type = "cpu";
   reg = <1>;
   enable-method = "psci";
   power-domains = <&CPU_PD1>;
   power-domain-names = "psci";
  };
 };

 arm-pmu {
  interrupts = <0 368 4>,
        <0 369 4>;
  interrupt-affinity = <&cpu0>, <&cpu1>;
 };

 psci {
  CPU_PD1: power-domain-cpu1 {
   #power-domain-cells = <0>;
   power-domains = <&CLUSTER_PD>;
  };
 };

 timer {
  interrupts = <1 13 ((((1 << (2)) - 1) << 8) | 8)>,
        <1 14 ((((1 << (2)) - 1) << 8) | 8)>,
        <1 11 ((((1 << (2)) - 1) << 8) | 8)>,
        <1 10 ((((1 << (2)) - 1) << 8) | 8)>;
 };
};

&optee {
 interrupts = <1 15 ((((1 << (2)) - 1) << 8) | 8)>;
};

&rifsc {
 ethernet2: ethernet@482d0000 {
  compatible = "st,stm32mp25-dwmac", "snps,dwmac-5.20";
  reg = <0x482d0000 0x4000>;
  reg-names = "stmmaceth";
  interrupts-extended = <&intc 0 133 4>;
  interrupt-names = "macirq";
  clock-names = "stmmaceth",
         "mac-clk-tx",
         "mac-clk-rx",
         "ptp_ref",
         "ethstp",
         "eth-ck";
  clocks = <&rcc 332>,
    <&rcc 331>,
    <&rcc 330>,
    <&rcc 319>,
    <&rcc 334>,
    <&rcc 317>;
  snps,axi-config = <&stmmac_axi_config_2>;
  snps,mixed-burst;
  snps,mtl-rx-config = <&mtl_rx_setup_2>;
  snps,mtl-tx-config = <&mtl_tx_setup_2>;
  snps,pbl = <2>;
  snps,tso;
  st,syscon = <&syscfg 0x3400>;
  access-controllers = <&rifsc 61>;
  status = "disabled";

  mtl_rx_setup_2: rx-queues-config {
   snps,rx-queues-to-use = <2>;
   queue0 {};
   queue1 {};
  };

  mtl_tx_setup_2: tx-queues-config {
   snps,tx-queues-to-use = <4>;
   queue0 {};
   queue1 {};
   queue2 {};
   queue3 {};
  };

  stmmac_axi_config_2: stmmac-axi-config {
   snps,blen = <0 0 0 0 16 8 4>;
   snps,rd_osr_lmt = <0x7>;
   snps,wr_osr_lmt = <0x7>;
  };
 };
};
# 7 "arch/arm64/boot/dts/st/stm32mp255.dtsi" 2

&rifsc {
 vdec: vdec@480d0000 {
  compatible = "st,stm32mp25-vdec";
  reg = <0x480d0000 0x3c8>;
  interrupts = <0 117 4>;
  clocks = <&rcc 216>;
  access-controllers = <&rifsc 89>;

 };

 venc: venc@480e0000 {
  compatible = "st,stm32mp25-venc";
  reg = <0x480e0000 0x800>;
  interrupts = <0 167 4>;
  clocks = <&rcc 217>;
  access-controllers = <&rifsc 90>;
 };
};
# 7 "arch/arm64/boot/dts/st/stm32mp257.dtsi" 2

/ {
};
