# 273 "arch/arm64/boot/dts/exynos/exynos9810.dtsi" 2
# 1 "./scripts/dtc/include-prefixes/arm/samsung/exynos-syscon-restart.dtsi" 1





&pmu_system_controller {
 poweroff: syscon-poweroff {
  compatible = "syscon-poweroff";
  regmap = <&pmu_system_controller>;
  offset = <0x330c>;
  mask = <0x5200>;
 };

 reboot: syscon-reboot {
  compatible = "syscon-reboot";
  regmap = <&pmu_system_controller>;
  offset = <0x0400>;
  mask = <0x1>;
 };
};
# 274 "arch/arm64/boot/dts/exynos/exynos9810.dtsi" 2
# 11 "arch/arm64/boot/dts/exynos/exynos9810-starlte.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 12 "arch/arm64/boot/dts/exynos/exynos9810-starlte.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h" 1
# 13 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/linux-event-codes.h" 1
# 14 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h" 2
# 13 "arch/arm64/boot/dts/exynos/exynos9810-starlte.dts" 2

/ {
 model = "Samsung Galaxy S9 (SM-G960F)";
 compatible = "samsung,starlte", "samsung,exynos9810";
 chassis-type = "handset";

 chosen {
  #address-cells = <2>;
  #size-cells = <1>;
  ranges;

  framebuffer@cc000000 {
   compatible = "simple-framebuffer";
   reg = <0x0 0xcc000000 (1440 * 2960 * 4)>;
   width = <1440>;
   height = <2960>;
   stride = <(1440 * 4)>;
   format = "a8r8g8b8";
  };
 };

 gpio-keys {
  compatible = "gpio-keys";

  pinctrl-0 = <&key_power &key_voldown &key_volup &key_wink>;
  pinctrl-names = "default";

  power-key {
   label = "Power";
   linux,code = <116>;
   gpios = <&gpa2 4 1>;
   wakeup-source;
  };

  voldown-key {
   label = "Volume Down";
   linux,code = <114>;
   gpios = <&gpa0 4 1>;
  };

  volup-key {
   label = "Volume Up";
   linux,code = <115>;
   gpios = <&gpa0 3 1>;
  };


  wink-key {
   label = "Camera";
   linux,code = <212>;
   gpios = <&gpa0 6 1>;
  };
 };

 memory@80000000 {
  device_type = "memory";
  reg = <0x0 0x80000000 0x3c800000>,
        <0x0 0xc0000000 0x20000000>,
        <0x0 0xe1900000 0x1e700000>,
        <0x8 0x80000000 0x80000000>;
 };

 reserved-memory {
  #address-cells = <2>;
  #size-cells = <1>;
  ranges;

  framebuffer@cc000000 {
   reg = <0x0 0xcc000000 (1440 * 2960 * 4)>;
   no-map;
  };
 };
};

&oscclk {
 clock-frequency = <26000000>;
};

&pinctrl_alive {
 key_power: key-power-pins {
  samsung,pins = "gpa2-4";
  samsung,pin-function = <0xf>;
  samsung,pin-pud = <3>;
  samsung,pin-drv = <0>;
 };

 key_voldown: key-voldown-pins {
  samsung,pins = "gpa0-4";
  samsung,pin-function = <0xf>;
  samsung,pin-pud = <3>;
  samsung,pin-drv = <0>;
 };

 key_volup: key-volup-pins {
  samsung,pins = "gpa0-3";
  samsung,pin-function = <0xf>;
  samsung,pin-pud = <3>;
  samsung,pin-drv = <0>;
 };

 key_wink: key-wink-pins {
  samsung,pins = "gpa0-6";
  samsung,pin-function = <0xf>;
  samsung,pin-pud = <3>;
  samsung,pin-drv = <0>;
 };
};
