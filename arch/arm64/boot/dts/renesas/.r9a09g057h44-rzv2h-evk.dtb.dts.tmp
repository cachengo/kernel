  ostm5: timer@12c01000 {
   compatible = "renesas,r9a09g057-ostm", "renesas,ostm";
   reg = <0x0 0x12c01000 0x0 0x1000>;
   interrupts = <0 22 1>;
   clocks = <&cpg 1 0x48>;
