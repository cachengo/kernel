   status = "disabled";
  };

  gic: interrupt-controller@14900000 {
   compatible = "arm,gic-v3";
   reg = <0x0 0x14900000 0 0x20000>,
         <0x0 0x14940000 0 0x80000>;
   #interrupt-cells = <3>;
   #address-cells = <0>;
   interrupt-controller;
   interrupts = <1 9 8>;
  };

  sdhi0: mmc@15c00000 {
   compatible = "renesas,sdhi-r9a09g057";
   reg = <0x0 0x15c00000 0 0x10000>;
   interrupts = <0 735 4>,
         <0 736 4>;
   clocks = <&cpg 1 0xa3>, <&cpg 1 0xa5>,
     <&cpg 1 0xa4>, <&cpg 1 0xa6>;
   clock-names = "core", "clkh", "cd", "aclk";
   resets = <&cpg 0xa7>;
   power-domains = <&cpg>;
   status = "disabled";
  };

  sdhi1: mmc@15c10000 {
   compatible = "renesas,sdhi-r9a09g057";
   reg = <0x0 0x15c10000 0 0x10000>;
   interrupts = <0 737 4>,
         <0 738 4>;
   clocks = <&cpg 1 0xa7>, <&cpg 1 0xa9>,
     <&cpg 1 0xa8>, <&cpg 1 0xaa>;
   clock-names = "core", "clkh", "cd", "aclk";
   resets = <&cpg 0xa8>;
   power-domains = <&cpg>;
