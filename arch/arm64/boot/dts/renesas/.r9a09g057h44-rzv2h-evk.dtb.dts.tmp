   resets = <&cpg 0xa9>;
   power-domains = <&cpg>;
   status = "disabled";
  };
 };

 timer {
  compatible = "arm,armv8-timer";
  interrupts-extended = <&gic 1 13 8>,
          <&gic 1 14 8>,
          <&gic 1 11 8>,
          <&gic 1 10 8>,
          <&gic 1 12 8>;
  interrupt-names = "sec-phys", "phys", "virt", "hyp-phys", "hyp-virt";
 };
};
# 13 "arch/arm64/boot/dts/renesas/r9a09g057h44-rzv2h-evk.dts" 2

/ {
 model = "Renesas RZ/V2H EVK Board based on r9a09g057h44";
 compatible = "renesas,rzv2h-evk", "renesas,r9a09g057h44", "renesas,r9a09g057";

 aliases {
  i2c0 = &i2c0;
  i2c1 = &i2c1;
  i2c2 = &i2c2;
  i2c3 = &i2c3;
  i2c6 = &i2c6;
  i2c7 = &i2c7;
  i2c8 = &i2c8;
  mmc1 = &sdhi1;
  serial0 = &scif;
 };

 chosen {
  bootargs = "ignore_loglevel";
  stdout-path = "serial0:115200n8";
 };

 memory@48000000 {
  device_type = "memory";

  reg = <0x0 0x48000000 0x1 0xF8000000>;
 };

 memory@240000000 {
  device_type = "memory";
  reg = <0x2 0x40000000 0x2 0x00000000>;
 };

 reg_3p3v: regulator1 {
  compatible = "regulator-fixed";

  regulator-name = "fixed-3.3V";
  regulator-min-microvolt = <3300000>;
  regulator-max-microvolt = <3300000>;
  regulator-boot-on;
  regulator-always-on;
 };

 vqmmc_sdhi1: regulator-vccq-sdhi1 {
  compatible = "regulator-gpio";
  regulator-name = "SDHI1 VccQ";
  gpios = <&pinctrl ((10) * 8 + (2)) 0>;
  regulator-min-microvolt = <1800000>;
  regulator-max-microvolt = <3300000>;
  gpios-states = <0>;
  states = <3300000 0>, <1800000 1>;
 };
};

&audio_extal_clk {
 clock-frequency = <22579200>;
};

&i2c0 {
 pinctrl-0 = <&i2c0_pins>;
 pinctrl-names = "default";
 clock-frequency = <400000>;

 status = "okay";
};

&i2c1 {
 pinctrl-0 = <&i2c1_pins>;
 pinctrl-names = "default";
 clock-frequency = <400000>;

 status = "okay";
};

