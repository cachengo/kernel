   reg = <0 0x11c01000 0 0x400>;
   interrupts = <0 222 4>,
         <0 523 1>,
         <0 522 1>,
         <0 224 4>,
         <0 225 4>,
         <0 223 4>,
         <0 226 4>,
         <0 227 4>;
   interrupt-names = "tei", "ri", "ti", "spi", "sti",
       "naki", "ali", "tmoi";
   clocks = <&cpg 1 0x93>;
   resets = <&cpg 0xa0>;
   power-domains = <&cpg>;
   #address-cells = <1>;
