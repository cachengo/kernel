  ostm7: timer@12c03000 {
   compatible = "renesas,r9a09g057-ostm", "renesas,ostm";
   reg = <0x0 0x12c03000 0x0 0x1000>;
   interrupts = <0 24 1>;
   clocks = <&cpg 1 0x4a>;
   resets = <&cpg 0x74>;
   power-domains = <&cpg>;
   status = "disabled";
  };

  wdt0: watchdog@11c00400 {
   compatible = "renesas,r9a09g057-wdt";
   reg = <0 0x11c00400 0 0x400>;
   clocks = <&cpg 1 0x4b>, <&cpg 1 0x4c>;
   clock-names = "pclk", "oscclk";
   resets = <&cpg 0x75>;
   power-domains = <&cpg>;
   status = "disabled";
  };

  wdt1: watchdog@14400000 {
   compatible = "renesas,r9a09g057-wdt";
   reg = <0 0x14400000 0 0x400>;
   clocks = <&cpg 1 0x4d>, <&cpg 1 0x4e>;
   clock-names = "pclk", "oscclk";
   resets = <&cpg 0x76>;
   power-domains = <&cpg>;
   status = "disabled";
  };

  wdt2: watchdog@13000000 {
   compatible = "renesas,r9a09g057-wdt";
   reg = <0 0x13000000 0 0x400>;
   clocks = <&cpg 1 0x4f>, <&cpg 1 0x50>;
   clock-names = "pclk", "oscclk";
   resets = <&cpg 0x77>;
   power-domains = <&cpg>;
   status = "disabled";
  };

  wdt3: watchdog@13000400 {
   compatible = "renesas,r9a09g057-wdt";
   reg = <0 0x13000400 0 0x400>;
   clocks = <&cpg 1 0x51>, <&cpg 1 0x52>;
   clock-names = "pclk", "oscclk";
   resets = <&cpg 0x78>;
   power-domains = <&cpg>;
   status = "disabled";
  };

  scif: serial@11c01400 {
   compatible = "renesas,scif-r9a09g057";
   reg = <0 0x11c01400 0 0x400>;
   interrupts = <0 529 4>,
         <0 532 4>,
         <0 533 4>,
         <0 530 4>,
         <0 534 4>,
         <0 531 4>,
         <0 535 4>,
         <0 536 1>,
         <0 537 1>;
   interrupt-names = "eri", "rxi", "txi", "bri", "dri",
       "tei", "tei-dri", "rxi-edge", "txi-edge";
   clocks = <&cpg 1 0x8f>;
   clock-names = "fck";
   power-domains = <&cpg>;
   resets = <&cpg 0x95>;
   status = "disabled";
  };

  i2c0: i2c@14400400 {
   compatible = "renesas,riic-r9a09g057";
   reg = <0 0x14400400 0 0x400>;
   interrupts = <0 174 4>,
